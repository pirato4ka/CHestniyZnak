	ПериодЗаполнения.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьКодыМаркировкиВДокументахНаСервере()
	
	МассивСтрок = Объект.ДокументыОтгрузки.НайтиСтроки(Новый Структура("КодыЗаполнены", Истина));
	Для Каждого Строка Из МассивСтрок Цикл
		
		лОбъект = Строка.Документ.ПолучитьОбъект();
		лОбъект.ШтрихкодыУпаковок.Очистить();
		
		// Индикаторы маркировки строк табличной части "Товары" - в нейтральное состояние
		// (ТЗ, задача 4).
		НомераСтрок = Новый Массив;
		Для Каждого СтрокаТовар Из лОбъект.Товары Цикл
			НомераСтрок.Добавить(СтрокаТовар.НомерСтроки);
		КонецЦикла;
		БНС_ОбщегоНазначенияГИСМ.СброситьСтатусыМаркировкиСтрокТаблицыТоваров(лОбъект, НомераСтрок);
		
		Попытка
			лОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю(Строка(Строка.Документ) + ": " + ОписаниеОшибки());
			
		КонецПопытки;
		
		Строка.КодыЗаполнены   = Ложь;
		Строка.КоличествоКодов = 0;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКодыМаркировкиВДокументах(Команда)
	ОчиститьКодыМаркировкиВДокументахНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыМаркировкиВДокументахНаСервере()

	// ++ БНС: подбор кодов маркировки по остаткам регистра БНС_ОстаткиИСМП
	// (ТЗ, задачи 1, 4, 5). Частичный подбор по строке запрещен: если свободных кодов
	// меньше, чем требуется по строке товара, коды по строке не подбираются, а ранее
	// подобранные коды строки очищаются; документ заполняется по остальным строкам
	// и проводится без блокирующих ошибок.
	МассивСтрок = Объект.ДокументыОтгрузки.НайтиСтроки(Новый Структура("КодыЗаполнены", Ложь));
	Для Каждого Строка Из МассивСтрок Цикл
		
		ПредставлениеДокумента = Строка(Строка.Документ) + ": ";
		
		РезультатПодбора = БНС_ОбщегоНазначенияГИСМ.ПодобратьКодыМаркировки(Строка.Документ);
		
		лОбъект = Строка.Документ.ПолучитьОбъект();
		лОбъект.ШтрихкодыУпаковок.Очистить();
		
		Для Каждого СтрокаКода Из РезультатПодбора.Коды Цикл
			НоваяСтрока = лОбъект.ШтрихкодыУпаковок.Добавить();
			НоваяСтрока.ШтрихкодУпаковки = СтрокаКода.ШтрихкодУпаковки;
			НоваяСтрока.Количество       = СтрокаКода.Количество;
		КонецЦикла;
		
		// Задача 4: индикаторы маркировки строк без кодов - в нейтральное состояние.
		БНС_ОбщегоНазначенияГИСМ.СброситьСтатусыМаркировкиСтрокТаблицыТоваров(лОбъект, РезультатПодбора.НомераСтрокБезКодов);
		
		// Задача 5: одно сообщение на строку с привязкой к ячейке табличной части
		// "Товары" документа отгрузки, сообщения не блокируют работу.
		БНС_ОбщегоНазначенияГИСМ.ВывестиСообщенияПодбора(РезультатПодбора, ПредставлениеДокумента);
		
		УспехЗаписи = Истина;
		
		Попытка
			лОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			УспехЗаписи = Ложь;
			ОбщегоНазначения.СообщитьПользователю(ПредставлениеДокумента + ОписаниеОшибки());
		КонецПопытки;
		
		Если УспехЗаписи Тогда
			Строка.КодыЗаполнены   = лОбъект.ШтрихкодыУпаковок.Количество() > 0;
			Строка.КоличествоКодов = лОбъект.ШтрихкодыУпаковок.Количество();
		КонецЕсли;
		
	КонецЦикла;
	// -- БНС

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодыМаркировкиВДокументах(Команда)
	ЗаполнитьКодыМаркировкиВДокументахНаСервере();
КонецПроцедуры

