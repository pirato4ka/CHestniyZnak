&НаСервере
Процедура ЗаполнитьДокументыНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслуг.Ссылка КАК Документ,
	               |	РеализацияТоваровУслуг.Контрагент КАК Контрагент
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	РеализацияТоваровУслуг.Проведен
	               |	И РеализацияТоваровУслуг.Дата МЕЖДУ &Дата1 И &Дата2
	               |	И РеализацияТоваровУслуг.Товары.Номенклатура В
	               |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |				ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура
	               |			ИЗ
	               |				РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Документ
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Дата1", НачалоДня(ПериодЗаполнения.ДатаНачала));
	Запрос.УстановитьПараметр("Дата2", КонецДня(ПериодЗаполнения.ДатаОкончания));

	Выборка = Запрос.Выполнить().Выбрать();
	
	Объект.ДокументыОтгрузки.Очистить();
	
	Пока Выборка.Следующий() Цикл;
		
		НоваяСтрока = Объект.ДокументыОтгрузки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.КодыЗаполнены   = Выборка.Документ.ШтрихкодыУпаковок.Количество() > 0;
		НоваяСтрока.КоличествоКодов = Выборка.Документ.ШтрихкодыУпаковок.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументы(Команда)
	ЗаполнитьДокументыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПериодЗаполнения.ДатаНачала    = НачалоМесяца(ТекущаяДатаСеанса());
	ПериодЗаполнения.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьКодыМаркировкиВДокументахНаСервере()
	
	МассивСтрок = Объект.ДокументыОтгрузки.НайтиСтроки(Новый Структура("КодыЗаполнены", Истина));
	Для Каждого Строка Из МассивСтрок Цикл
		
		лОбъект = Строка.Документ.ПолучитьОбъект();
		лОбъект.ШтрихкодыУпаковок.Очистить();
		
		Попытка
			лОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
			
		КонецПопытки;
		
		Строка.КодыЗаполнены   = Ложь;
		Строка.КоличествоКодов = 0;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКодыМаркировкиВДокументах(Команда)
	ОчиститьКодыМаркировкиВДокументахНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыМаркировкиВДокументахНаСервере()
	
	МассивСтрок = Объект.ДокументыОтгрузки.НайтиСтроки(Новый Структура("КодыЗаполнены", Ложь));
	Для Каждого Строка Из МассивСтрок Цикл
		
		лОбъект = Строка.Документ.ПолучитьОбъект();
		
		// Используем единую логику автоподбора из общего модуля БНС, которая поддерживает
		// два режима: ОСУ (GS1-128, (02) + GTIN + (37) + количество, МонотоварнаяУпаковка, количество = полное)
		// и Поэкземплярно (DataMatrix (01)+(21), количество = 1, выбор ПЕРВЫЕ N свободных марок).
		// Режим определяется на ДатаДокумента по регистру сроков ввода маркировки:
		// ОптоваяТорговля.ОСУ = "действует" и ОптоваяТорговля.Поэкземплярно не "действует" -> ОСУ,
		// иначе если ОптоваяТорговля.Поэкземплярно = "действует" -> Поэкземплярно.
		РезультатЗаполнения = БНС_ОбщегоНазначенияГИСМ.ЗаполнитьМаркировкуРеализации(лОбъект);
		
		Если РезультатЗаполнения.Недозаполнено Тогда
			// Если марок на остатке меньше, чем требуется для поштучной номенклатуры,
			// заполняем сколько есть, выводим информационное сообщение, строка остается недозаполненной (красный статус)
			ОбщегоНазначения.СообщитьПользователю(РезультатЗаполнения.Сообщение);
			// Не прерываем проведение остальных документов, но не помечаем как заполненный если недозаполнено
			Если РезультатЗаполнения.КоличествоЗаписей = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			лОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		Строка.КодыЗаполнены   = Не РезультатЗаполнения.Недозаполнено;
		Строка.КоличествоКодов = лОбъект.ШтрихкодыУпаковок.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКодыМаркировкиВДокументах(Команда)
	ЗаполнитьКодыМаркировкиВДокументахНаСервере();
КонецПроцедуры

