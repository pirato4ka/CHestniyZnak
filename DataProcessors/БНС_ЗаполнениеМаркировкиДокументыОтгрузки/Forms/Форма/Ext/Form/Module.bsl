&НаСервере
Процедура УстановитьОтветственногоНаСервере()
	
	Для Каждого Строка Из Объект.ДокументыОтгрузки Цикл
		
		лОбъект = Строка.Документ.ПолучитьОбъект();
		лОбъект.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("edo");
		
		Попытка
			лОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтветственного(Команда)
	УстановитьОтветственногоНаСервере();
КонецПроцедуры
