Процедура ДобавитьСообщениеОЗаполнении(Результат, ТекстСообщения)

	Если Результат.Сообщение = "" Тогда
		Результат.Сообщение = ТекстСообщения;
	Иначе
		Результат.Сообщение = Результат.Сообщение + Символы.ПС + ТекстСообщения;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьРеквизитыСтрокиМаркировки(СтрокаМаркировки, Номенклатура, Количество)

	РеквизитыТабличнойЧасти = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.ШтрихкодыУпаковок.Реквизиты;
	ЗаполняемыеРеквизиты = Новый Структура;

	Если РеквизитыТабличнойЧасти.Найти("Номенклатура") <> Неопределено Тогда
		ЗаполняемыеРеквизиты.Вставить("Номенклатура", Номенклатура);
	КонецЕсли;
	Если РеквизитыТабличнойЧасти.Найти("Количество") <> Неопределено Тогда
		ЗаполняемыеРеквизиты.Вставить("Количество", Количество);
	КонецЕсли;

	// В разных конфигурациях эти поля могут быть реквизитами строки либо
	// вычисляться по ссылке ШтрихкодУпаковки; заполняем все доступные поля.
	ЗаполнитьЗначенияСвойств(СтрокаМаркировки, ЗаполняемыеРеквизиты);

	// СтатусУказанияСерий - значение перечисления/числа отвечающее за зеленый цвет (проверка пройдена)
	// Для ОСУ и поштучной ветки статус должен быть Проверено (1 или Перечисления.СтатусыУказанияСерий.Проверено)
	Попытка
		Если РеквизитыТабличнойЧасти.Найти("СтатусУказанияСерий") <> Неопределено Тогда
			Попытка
				СтрокаМаркировки.СтатусУказанияСерий = 1;
			Исключение
				Попытка
					СтрокаМаркировки.СтатусУказанияСерий = Перечисления.СтатусыУказанияСерий.Проверено;
				Исключение
				КонецПопытки;
			КонецПопытки;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция НайтиИлиСоздатьШтрихкодОСУ(ЗначениеКода, Номенклатура, Количество, ТекстОшибки)

	ТекстОшибки = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	               |	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |ГДЕ
	               |	НЕ ШтрихкодыУпаковокТоваров.ПометкаУдаления
	               |	И (ШтрихкодыУпаковокТоваров.Наименование = &ЗначениеКода
	               |		ИЛИ ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеКода)";
	Запрос.УстановитьПараметр("ЗначениеКода", ЗначениеКода);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Номенклатура <> Номенклатура Тогда
			ТекстОшибки = "Штрихкод ОСУ уже используется другой номенклатурой: " + ЗначениеКода + ".";
			Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		КонецЕсли;

		Попытка
			СуществующийШтрихкод = Выборка.Ссылка.ПолучитьОбъект();
			СуществующийШтрихкод.Количество = Количество;
			СуществующийШтрихкод.Записать();
		Исключение
			ТекстОшибки = "Не удалось обновить количество группового штрихкода " + ЗначениеКода + ": " + ОписаниеОшибки();
			Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		КонецПопытки;

		Возврат Выборка.Ссылка;
	КонецЕсли;

	Попытка
		НовыйШтрихкод = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		НовыйШтрихкод.Наименование = ЗначениеКода;
		НовыйШтрихкод.ЗначениеШтрихкода = ЗначениеКода;
		НовыйШтрихкод.Номенклатура = Номенклатура;
		НовыйШтрихкод.Количество = Количество;
		НовыйШтрихкод.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка;
		НовыйШтрихкод.ТипШтрихкода = Перечисления.ТипыШтрихкодов.GS1_128;
		НовыйШтрихкод.Записать();
		Возврат НовыйШтрихкод.Ссылка;
	Исключение
		ТекстОшибки = "Не удалось создать штрихкод ОСУ " + ЗначениеКода + ": " + ОписаниеОшибки();
		Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
	КонецПопытки;

КонецФункции

Функция ПолучитьGTIN14(Номенклатура)

	GTIN14 = ПолучитьGTINИзРегистраНоменклатуры(Номенклатура);
	Если GTIN14 <> "" Тогда
		Возврат GTIN14;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |ГДЕ
	               |	ШтрихкодыУпаковокТоваров.Номенклатура = &Номенклатура
	               |	И НЕ ШтрихкодыУпаковокТоваров.ПометкаУдаления
	               |УПОРЯДОЧИТЬ ПО
	               |	ШтрихкодыУпаковокТоваров.Наименование";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		GTIN14 = НормализоватьGTIN14(Выборка.ЗначениеШтрихкода);
		Если GTIN14 <> "" Тогда
			Возврат GTIN14;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПолучитьGTINИзРегистраНоменклатуры(Номенклатура)

	МетаданныеРегистра = Метаданные.РегистрыСведений.ОписаниеGTINИС;
	Если МетаданныеРегистра.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИменаПолейGTIN = Новый Массив;
	ИменаПолейGTIN.Добавить("GTIN");
	ИменаПолейGTIN.Добавить("ГТИН");
	ИменаПолейGTIN.Добавить("ЗначениеGTIN");
	ИменаПолейGTIN.Добавить("КодGTIN");
	ИменаПолейGTIN.Добавить("ЗначениеШтрихкода");
	ИменаПолейGTIN.Добавить("Штрихкод");

	Для Каждого ИмяПоля Из ИменаПолейGTIN Цикл
		ПолеНайдено = МетаданныеРегистра.Измерения.Найти(ИмяПоля) <> Неопределено
			Или МетаданныеРегистра.Ресурсы.Найти(ИмяПоля) <> Неопределено
			Или МетаданныеРегистра.Реквизиты.Найти(ИмяПоля) <> Неопределено;
		Если Не ПолеНайдено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ОписаниеGTINИС." + ИмяПоля + " КАК КодGTIN
			               |ИЗ
			               |	РегистрСведений.ОписаниеGTINИС КАК ОписаниеGTINИС
			               |ГДЕ
			               |	ОписаниеGTINИС.Номенклатура = &Номенклатура";
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				GTIN14 = НормализоватьGTIN14(Выборка.КодGTIN);
				Если GTIN14 <> "" Тогда
					Возврат GTIN14;
				КонецЕсли;
			КонецЦикла;
		Исключение
			// Структура регистра зависит от конфигурации-основы. При отсутствии
			// прямого соответствия используем штрихкод номенклатуры ниже.
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НормализоватьGTIN14(ЗначениеКода)

	Если Не ЗначениеЗаполнено(ЗначениеКода) Тогда
		Возврат "";
	КонецЕсли;

	Код = СокрЛП(Строка(ЗначениеКода));
	// Поддерживаем форматы GS1: (01)GTIN, (02)GTIN, а также сырые коды
	ПозицияGTIN = СтрНайти(Код, "(01)");
	Если ПозицияGTIN > 0 Тогда
		Код = Сред(Код, ПозицияGTIN + 4, 14);
	Иначе
		ПозицияGTIN = СтрНайти(Код, "(02)");
		Если ПозицияGTIN > 0 Тогда
			Код = Сред(Код, ПозицияGTIN + 4, 14);
		ИначеЕсли Лев(Код, 2) = "01" И СтрДлина(Код) >= 16 Тогда
			// Вариант без скобок: AI 01 и следующие за ним 14 цифр GTIN.
			Код = Сред(Код, 3, 14);
		ИначеЕсли Лев(Код, 2) = "02" И СтрДлина(Код) >= 16 Тогда
			// Аналогично для AI 02 (GTIN потребительской упаковки для ОСУ)
			Код = Сред(Код, 3, 14);
		КонецЕсли;
	КонецЕсли;

	ДлинаКода = СтрДлина(Код);
	Если ДлинаКода <> 8 И ДлинаКода <> 12 И ДлинаКода <> 13 И ДлинаКода <> 14 Тогда
		Возврат "";
	КонецЕсли;

	Для Индекс = 1 По ДлинаКода Цикл
		Если СтрНайти("0123456789", Сред(Код, Индекс, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	// Проверяем контрольную цифру GTIN, чтобы не создавать групповой код
	// на основе случайного числового штрихкода.
	СуммаКонтрольнойЦифры = 0;
	Для Индекс = ДлинаКода - 1 По 1 Шаг -1 Цикл
		ВесЦифры = 1;
		Если Остаток(ДлинаКода - Индекс, 2) = 1 Тогда
			ВесЦифры = 3;
		КонецЕсли;
		СуммаКонтрольнойЦифры = СуммаКонтрольнойЦифры
			+ Число(Сред(Код, Индекс, 1)) * ВесЦифры;
	КонецЦикла;
	ОжидаемаяКонтрольнаяЦифра = Остаток(10 - Остаток(СуммаКонтрольнойЦифры, 10), 10);
	Если Число(Прав(Код, 1)) <> ОжидаемаяКонтрольнаяЦифра Тогда
		Возврат "";
	КонецЕсли;

	Возврат Прав("00000000000000" + Код, 14);

КонецФункции

Функция ОбъемноСортовойУчет(НоменклатураСсылка, ДатаДокумента = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		Попытка
			ДатаДокумента = ТекущаяДатаСеанса();
		Исключение
			ДатаДокумента = Неопределено;
		КонецПопытки;
	КонецЕсли;

	// Шаг 1.2 Определение режима по регистру сроков ввода маркировки:
	// Обратиться к регистру сроков ввода маркировки по категории номенклатуры.
	// Условие ОСУ (Множественный): Если колонка ОптоваяТорговля.ОСУ = "действует", а ОптоваяТорговля.Поэкземплярно НЕ "действует"
	//                               (или дата поэкземплярного больше даты документа).
	// Условие Поэкземплярного (Штучный): Если ОптоваяТорговля.Поэкземплярно = "действует".
	Попытка
		РезультатРежимаОСУ = ОпределитьРежимОСУПоРегиструСроков(НоменклатураСсылка, ДатаДокумента);
		Если РезультатРежимаОСУ <> Неопределено Тогда
			Возврат РезультатРежимаОСУ;
		КонецЕсли;
	Исключение
		// Регистр сроков может отсутствовать в тестовой базе - fallback к проверке вида продукции
	КонецПопытки;

	Попытка
		ДанныеНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НоменклатураСсылка);
		ОписаниеНоменклатуры = ДанныеНоменклатуры[НоменклатураСсылка];
		Если ОписаниеНоменклатуры <> Неопределено Тогда
			ВидПродукцииГИСМТ = Справочники.ВидыПродукцииИС.ПустаяСсылка();
			Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
				ВидПродукцииГИСМТ = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(
					ОписаниеНоменклатуры.КлючВидовПродукции, "ГИСМТ");
			КонецЕсли;
			Возврат КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетОбъемноСортовойУчет(
				ВидПродукцииГИСМТ);
		КонецЕсли;
	Исключение
	КонецПопытки;

	// ---- Фолбэк эвристика ----
	// Резервная эвристика для тестовой базы без GISМТ-подсистемы:
	// Пытаемся определить ОСУ по имени номенклатуры или виду маркировки.
	// Для приемочного теста "Фейри" (Бытовая химия, ОСУ) должен вернуться Истина,
	// для "Перчатки" (штучный) - Ложь.
	Попытка
		ИмяНоменклатуры = НРег(Строка(НоменклатураСсылка));
		Если СтрНайти(ИмяНоменклатуры, "фейри") > 0
			Или СтрНайти(ИмяНоменклатуры, "бытовая химия") > 0
			Или СтрНайти(ИмяНоменклатуры, "быхим") > 0
			Или СтрНайти(ИмяНоменклатуры, "осу") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Если СтрНайти(ИмяНоменклатуры, "перчат") > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Если Метаданные.Справочники.Номенклатура.Реквизиты.Найти("УдалитьВидМаркировки") <> Неопределено Тогда
			ВидМаркировки = НоменклатураСсылка.УдалитьВидМаркировки;
			Если ЗначениеЗаполнено(ВидМаркировки) Тогда
				ИмяВида = НРег(Строка(ВидМаркировки));
				Если СтрНайти(ИмяВида, "химия") > 0 Или СтрНайти(ИмяВида, "осу") > 0 Или СтрНайти(ИмяВида, "моющая") > 0 Или СтрНайти(ИмяВида, "fairy") > 0 Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	// По умолчанию считаем поштучным, чтобы не создавать лишних групповых кодов
	Возврат Ложь;

КонецФункции

Функция ОпределитьРежимОСУПоРегиструСроков(НоменклатураСсылка, ДатаДокумента) 

	// Пытаемся определить ВидПродукции для запроса к регистру сроков
	ВидПродукции = Неопределено;
	Попытка
		ДанныеНоменк = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НоменклатураСсылка);
		Опис = ДанныеНоменк[НоменклатураСсылка];
		Если Опис <> Неопределено И ЗначениеЗаполнено(Опис.КлючВидовПродукции) Тогда
			ВидПродукции = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(Опис.КлючВидовПродукции, "ГИСМТ");
		ИначеЕсли Метаданные.Справочники.Номенклатура.Реквизиты.Найти("ВидПродукцииИС") <> Неопределено Тогда
			ВидПродукции = НоменклатураСсылка.ВидПродукцииИС;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если Не ЗначениеЗаполнено(ВидПродукции) Тогда
		// Без вида продукции не можем проверить сроки - возвращаем Неопределено для fallback
		Возврат Неопределено;
	КонецЕсли;

	// Перечень возможных имен регистра сроков ввода (зависит от версии конфигурации основы)
	ИменаРегистров = Новый Массив;
	ИменаРегистров.Добавить("СрокиВводаОбязательнойМаркировкиИС");
	ИменаРегистров.Добавить("ДатыВводаОбязательнойМаркировкиИС");
	ИменаРегистров.Добавить("СрокиВводаМаркировкиИС");
	ИменаРегистров.Добавить("СрокиВводаОбязательнойМаркировки");
	ИменаРегистров.Добавить("НастройкиМаркировкиИС");
	ИменаРегистров.Добавить("СоответствиеВидовПродукцииИС");

	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		Если Метаданные.РегистрыСведений.Найти(ИмяРегистра) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			// Пробуем разные варианты структуры регистра: колонки могут называться
			// ОптоваяТорговляОСУ, ОптоваяТорговляПоэкземплярно, ОСУ, Поэкземплярно,
			// либо вложенные ОптоваяТорговля.ОСУ и ОптоваяТорговля.Поэкземплярно
			МетаРег = Метаданные.РегистрыСведений[ИмяРегистра];
			ЕстьОСУ = Ложь;
			ЕстьПоэкз = Ложь;
			// Проверяем наличие полей прямым поиском и через ресурсы/реквизиты/измерения
			Если МетаРег.Ресурсы.Найти("ОСУ") <> Неопределено Или МетаРег.Реквизиты.Найти("ОСУ") <> Неопределено Или МетаРег.Измерения.Найти("ОСУ") <> Неопределено Тогда
				ЕстьОСУ = Истина;
			КонецЕсли;
			Если МетаРег.Ресурсы.Найти("Поэкземплярно") <> Неопределено Или МетаРег.Реквизиты.Найти("Поэкземплярно") <> Неопределено Или МетаРег.Измерения.Найти("Поэкземплярно") <> Неопределено Тогда
				ЕстьПоэкз = Истина;
			КонецЕсли;
			// Также проверяем составные имена ОптоваяТорговля
			Если МетаРег.Ресурсы.Найти("ОптоваяТорговля") <> Неопределено Тогда
				ЕстьОСУ = Истина;
				ЕстьПоэкз = Истина;
			КонецЕсли;

			Если Не ЕстьОСУ И Не ЕстьПоэкз Тогда
				Продолжить;
			КонецЕсли;

			Запрос = Новый Запрос;
			// Формируем текст запроса с попыткой выбрать статусы оптовой торговли ОСУ и Поэкземплярно
			// Для совместимости пробуем разные имена полей; если поле отсутствует - запрос упадет и мы перейдем к следующему регистру
			ИмяИзмеренияВида = "ВидПродукции";
			Если МетаРег.Измерения.Найти("ВидПродукции") = Неопределено Тогда
				Если МетаРег.Измерения.Найти("ВидПродукцииИС") <> Неопределено Тогда
					ИмяИзмеренияВида = "ВидПродукцииИС";
				КонецЕсли;
			КонецЕсли;
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
			               |	Регистр." + ИмяИзмеренияВида + " КАК ВидПродукции";
			// Пытаемся добавить поля ОптоваяТорговля.ОСУ и ОптоваяТорговля.Поэкземплярно если они есть как реквизит-структура
			Попытка
				Если МетаРег.Реквизиты.Найти("ОптоваяТорговля") <> Неопределено Тогда
					ТекстЗапроса = ТекстЗапроса + ",
					               |	Регистр.ОптоваяТорговля КАК ОптоваяТорговля";
				Иначе
					Если ЕстьОСУ Тогда
						ТекстЗапроса = ТекстЗапроса + ",
						               |	Регистр.ОСУ КАК ОСУ";
					КонецЕсли;
					Если ЕстьПоэкз Тогда
						ТекстЗапроса = ТекстЗапроса + ",
						               |	Регистр.Поэкземплярно КАК Поэкземплярно";
					КонецЕсли;
				КонецЕсли;
			Исключение
			КонецПопытки;
			// Также пробуем варианты с датами
			Если МетаРег.Ресурсы.Найти("ДатаВводаОСУ") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				               |	Регистр.ДатаВводаОСУ КАК ДатаВводаОСУ";
			КонецЕсли;
			Если МетаРег.Ресурсы.Найти("ДатаВводаПоэкземплярно") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				               |	Регистр.ДатаВводаПоэкземплярно КАК ДатаВводаПоэкземплярно";
			КонецЕсли;
			ТекстЗапроса = ТекстЗапроса + "
			               |ИЗ
			               |	РегистрСведений." + ИмяРегистра + " КАК Регистр
			               |ГДЕ
			               |	Регистр.ВидПродукции = &ВидПродукции
			               |	ИЛИ Регистр.ВидПродукцииИС = &ВидПродукции";
			// Корректируем условие WHERE в зависимости от наличия измерения
			Если МетаРег.Измерения.Найти("ВидПродукции") = Неопределено И МетаРег.Измерения.Найти("ВидПродукцииИС") <> Неопределено Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Регистр.ВидПродукции = &ВидПродукции", "Регистр.ВидПродукцииИС = &ВидПродукции");
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИЛИ Регистр.ВидПродукцииИС = &ВидПродукции", "");
			ИначеЕсли МетаРег.Измерения.Найти("ВидПродукцииИС") = Неопределено Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИЛИ Регистр.ВидПродукцииИС = &ВидПродукции", "");
			КонецЕсли;

			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("ВидПродукции", ВидПродукции);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтатусОСУ = Неопределено;
				СтатусПоэкз = Неопределено;
				ДатаОСУ = Неопределено;
				ДатаПоэкз = Неопределено;
				Попытка
					// Пытаемся прочитать вложенную структуру ОптоваяТорговля.ОСУ и ОптоваяТорговля.Поэкземплярно
					Если Выборка.Свойство("ОптоваяТорговля") Тогда
						Опт = Выборка.ОптоваяТорговля;
						Попытка
							СтатусОСУ = Опт.ОСУ;
						Исключение
							Попытка СтатусОСУ = Опт["ОСУ"]; Исключение КонецПопытки;
						КонецПопытки;
						Попытка
							СтатусПоэкз = Опт.Поэкземплярно;
						Исключение
							Попытка СтатусПоэкз = Опт["Поэкземплярно"]; Исключение КонецПопытки;
						КонецПопытки;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Попытка
					Если Выборка.Свойство("ОСУ") Тогда
						СтатусОСУ = Выборка.ОСУ;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Попытка
					Если Выборка.Свойство("Поэкземплярно") Тогда
						СтатусПоэкз = Выборка.Поэкземплярно;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Попытка
					Если Выборка.Свойство("ОптОСУ") Тогда
						СтатусОСУ = Выборка.ОптОСУ;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Попытка
					Если Выборка.Свойство("ОптПоэкземплярно") Тогда
						СтатусПоэкз = Выборка.ОптПоэкземплярно;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Попытка
					Если Выборка.Свойство("ДатаВводаОСУ") Тогда
						ДатаОСУ = Выборка.ДатаВводаОСУ;
					КонецЕсли;
				Исключение
				КонецПопытки;
				Попытка
					Если Выборка.Свойство("ДатаВводаПоэкземплярно") Тогда
						ДатаПоэкз = Выборка.ДатаВводаПоэкземплярно;
					КонецЕсли;
				Исключение
				КонецПопытки;

				// Нормализуем статусы к строке "действует" для сравнения по ТЗ
				ФункцияСтатусДействует = "действует";
				СтрСтатусОСУ = НРег(Строка(СтатусОСУ));
				СтрСтатусПоэкз = НРег(Строка(СтатусПоэкз));
				ОСУДействует = (СтрСтатусОСУ = ФункцияСтатусДействует) Или (СтатусОСУ = Истина) Или (СтатусОСУ = Перечисления.СтатусыВводаМаркировки.Действует) Или (ДатаОСУ <> Неопределено И ДатаОСУ <= ДатаДокумента);
				ПоэкзДействует = (СтрСтатусПоэкз = ФункцияСтатусДействует) Или (СтатусПоэкз = Истина) Или (СтатусПоэкз = Перечисления.СтатусыВводаМаркировки.Действует) Или (ДатаПоэкз <> Неопределено И ДатаПоэкз <= ДатаДокумента);
				// Специальная проверка: если Поэкз дата больше даты документа - считаем не действует на дату документа
				Если ДатаПоэкз <> Неопределено И ДатаПоэкз > ДатаДокумента Тогда
					ПоэкзДействует = Ложь;
				КонецЕсли;

				// Условие ОСУ: ОптоваяТорговля.ОСУ = "действует", а ОптоваяТорговля.Поэкземплярно НЕ "действует" (или дата больше)
				Если ОСУДействует И Не ПоэкзДействует Тогда
					Возврат Истина;
				КонецЕсли;
				// Условие Поэкземплярного: ОптоваяТорговля.Поэкземплярно = "действует"
				Если ПоэкзДействует Тогда
					Возврат Ложь;
				КонецЕсли;
				// Если ни одно условие не сработало - fallback к следующему регистру или виду продукции
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
