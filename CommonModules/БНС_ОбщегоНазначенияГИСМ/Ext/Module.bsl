////////////////////////////////////////////////////////////////////////////////
//
// БНС_ОбщегоНазначенияГИСМ: серверные процедуры и функции подсистемы "ГИСМ"
//
// Реализовано по ТЗ "Исправление логики учета остатков ИС МП, схлопывания ОСУ,
// проведения документов и стандартизации интерфейса в расширении БНС_ГИСМ"
// (см. docs/ОписаниеИзменений_УчетОстатковИСМП.md):
//
//  Задача 1. Расход ОСУ формируется по фактическим остаткам регистра
//            БНС_ОстаткиИСМП методом FIFO в разрезе "Номенклатура + GTIN":
//            списание выполняется с тех записей штрихкодов упаковок, по которым
//            числится остаток, а не с "виртуального" штрихкода из документа.
//  Задача 2. Перед расчетом остатков старые движения документа физически
//            сбрасываются (Очистить() + Записать()), остатки читаются на
//            МоментВремени() документа с границей "Исключая", перед чтением
//            устанавливается управляемая блокировка данных.
//  Задача 3. Признак "ОбъемноСортовойУчет" определяется по настройкам товарной
//            категории (вида продукции ГИСМТ) на дату документа и синхронизируется
//            с типом упаковки справочника ШтрихкодыУпаковокТоваров
//            (ТипУпаковки = МонотоварнаяУпаковка).
//  Задача 4. При нехватке кодов строка не заполняется частично: коды по строке
//            очищаются, движения по регистру маркировки по строке не формируются,
//            проведение документа не блокируется.
//  Задача 5. Сообщения пользователю формируются по стандарту 1С:ИТС через
//            ОбщегоНазначения.СообщитьПользователю() с привязкой к ячейке
//            табличной части документа (одно сообщение на строку).
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

// Обработчик подписки БНС_ПроведениеДокументовГИСМ (событие "ОбработкаПроведения"
// документов ПоступлениеТоваровУслуг и РеализацияТоваровУслуг).
//
// Параметры:
//  Источник        - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг
//  Отказ           - Булево
//  РежимПроведения - РежимПроведения
//
Процедура ДокументПриПроведении(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Не БНС_ОбщегоНазначенияГИСМПовтИсп.ВестиУчетГИСМ() Тогда
		Возврат;
	КонецЕсли;
	
	// При отмене проведения движения по регистру удаляет платформа.
	Если РежимПроведения = РежимПроведения.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		СформироватьДвиженияПрихода(Источник);
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		СформироватьДвиженияРасхода(Источник, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Сбрасывает ранее записанные движения документа по регистру БНС_ОстаткиИСМП.
//
// Физическая очистка (Очистить() + Записать()) выполняется до расчета и проверки
// остатков: без нее документ при повторном проведении "видит" собственный расход
// в виртуальной таблице остатков, из-за чего движения двоятся либо выдается
// ложное сообщение о нехватке остатков (ТЗ, задача 2).
//
// Параметры:
//  Источник - ДокументОбъект.ПоступлениеТоваровУслуг, ДокументОбъект.РеализацияТоваровУслуг
//
Процедура ПодготовитьДвиженияКПересчету(Источник) Экспорт
	
	Движения = Источник.Движения;
	Движения.БНС_ОстаткиИСМП.Записывать = Истина;
	Движения.БНС_ОстаткиИСМП.Очистить();
	// Запись пустого набора физически сбрасывает старые движения документа в базе.
	Движения.БНС_ОстаткиИСМП.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеДвижений

// Формирует движения прихода по регистру БНС_ОстаткиИСМП по табличной части
// "ШтрихкодыУпаковок" документа поступления.
//
// Количество прихода берется из кода маркировки: для кода ОСУ (02)GTIN(37)N -
// количество N, для поштучного кода DataMatrix (01)GTIN(21)... - одна единица.
//
// Параметры:
//  Источник - ДокументОбъект.ПоступлениеТоваровУслуг
//
Процедура СформироватьДвиженияПрихода(Источник) Экспорт
	
	Движения = Источник.Движения;
	ПодготовитьДвиженияКПересчету(Источник);
	
	ДатаДокумента = Источник.Дата;
	
	Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл
		
		ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
		Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоПрихода = КоличествоКодаМаркировки(ШтрихкодУпаковки);
		Если КоличествоПрихода <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = НоменклатураШтрихкодаУпаковки(ШтрихкодУпаковки);
		
		Если Номенклатура = Неопределено Тогда
			// Номенклатуру кода определить не удалось (иная структура справочника):
			// движение не формируем, чтобы не записать незаполненное измерение регистра.
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(
				"Код упаковки ""%1"" не учтён в регистре (БНС) остатки ИС МП: не определена номенклатура кода.",
				КодШтрихкодаУпаковки(ШтрихкодУпаковки)));
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.БНС_ОстаткиИСМП.Добавить();
		Движение.ВидДвижения         = ВидДвиженияНакопления.Приход;
		Движение.Период              = ДатаДокумента;
		Движение.Регистратор         = Источник.Ссылка;
		Движение.ШтрихкодУпаковки    = ШтрихкодУпаковки;
		Движение.Номенклатура        = Номенклатура;
		Движение.Количество          = КоличествоПрихода;
		// ТЗ, задача 3: признак ОСУ определяется по настройкам товарной категории
		// на дату документа и по фактическому типу упаковки/кода маркировки.
		Движение.ОбъемноСортовойУчет = ПризнакОСУДляДвижения(Номенклатура, ДатаДокумента, ШтрихкодУпаковки);
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения расхода по регистру БНС_ОстаткиИСМП по табличной части
// "Товары" документа реализации.
//
// Алгоритм (ТЗ, задачи 1, 3, 4):
//  - по каждой маркируемой строке товаров определяются указанные в документе коды
//    маркировки; если кодов нет - движения по регистру маркировки не формируются,
//    документ проводится по данным бухгалтерского учета (проверка не блокирует проведение);
//  - для товаров с объемно-сортовым учетом (ОСУ) расход формируется по остаткам
//    регистра методом FIFO в разрезе "Номенклатура + GTIN": списание относится на те
//    штрихкоды упаковок, по которым числится остаток, остаток по штрихкоду уменьшается;
//  - для поштучного (поэкземплярного) учета расход формируется по указанным кодам
//    маркировки, но не более фактического остатка по коду.
//
// Параметры:
//  Источник - ДокументОбъект.РеализацияТоваровУслуг
//  Отказ    - Булево - не устанавливается: нехватка кодов маркировки не блокирует
//             проведение документа (ТЗ, задача 4).
//
Процедура СформироватьДвиженияРасхода(Источник, Отказ) Экспорт
	
	Движения = Источник.Движения;
	ПодготовитьДвиженияКПересчету(Источник);
	
	Потребности = ТаблицаПотребностиРеализации(Источник.Ссылка);
	
	Если Потребности.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Коды = ТаблицаКодовРеализации(Источник.Ссылка);
	
	МассивНоменклатуры = НоменклатураМаркируемыхСтрок(Потребности);
	
	// ТЗ, задача 2: управляемая блокировка данных перед чтением остатков
	// (исключает взаимные блокировки и параллельное списание одного остатка).
	ЗаблокироватьОстаткиИСМП(МассивНоменклатуры);
	
	МоментВремени = Источник.МоментВремени();
	Остатки       = ТаблицаОстатковКодов(МоментВремени, МассивНоменклатуры);
	
	КэшОСУ = Новый Соответствие;
	
	Для Каждого СтрокаПотребности Из Потребности Цикл
		
		Если Не СтрокаПотребности.ЭтоМаркируемая Тогда
			Продолжить;
		КонецЕсли;
		
		КодыСтроки = КодыСтрокиДокумента(Коды, СтрокаПотребности);
		
		// ТЗ, задача 4: маркировка по строке не указана - движения по регистру
		// маркировки не формируются, документ проводится.
		Если КодыСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПризнакОСУАлгоритма(СтрокаПотребности.Номенклатура, Источник.Дата, КодыСтроки, КэшОСУ) Тогда
			СписатьСтрокуОСУ(Движения, Источник, СтрокаПотребности, КодыСтроки, Остатки, КэшОСУ);
		Иначе
			СписатьСтрокуПоэкземплярно(Движения, Источник, СтрокаПотребности, КодыСтроки, Остатки, КэшОСУ);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКодовМаркировки

// Возвращает данные для заполнения кодов маркировки по остаткам регистра БНС_ОстаткиИСМП.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - документ отгрузки.
//
// Возвращаемое значение:
//  Структура:
//   * ТзнОбщий - ТаблицаЗначений - потребность документа по маркируемой номенклатуре:
//      ** Номенклатура - СправочникСсылка.Номенклатура
//      ** НомерСтроки  - Число - номер первой строки табличной части "Товары"
//      ** Количество   - Число - количество по документу
//      ** Остаток      - Число - суммарный остаток единиц по кодам
//   * ТзнКоды - ТаблицаЗначений - свободные коды маркировки (ФИФО по дате упаковки):
//      ** Номенклатура     - СправочникСсылка.Номенклатура
//      ** ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//      ** Остаток          - Число - остаток единиц по коду
//      ** КоличествоВКоде  - Число - объем кода (1 код = N единиц)
//      ** КодШтрихкода     - Строка - значение штрихкода (если реквизит есть в конфигурации)
//      ** GTIN             - Строка - GTIN-14, извлеченный из (01)/(02) кода
//      ** ЭтоМонотоварная  - Булево - тип упаковки "Монотоварная упаковка"
//      ** ЭтоОСУ           - Булево - признак объемно-сортового учета
//   * ТзнНеМаркируемые - ТаблицаЗначений - номенклатура вне регистра "Описание номенклатуры ИС"
//   * ДатаДокумента - Дата - дата документа, на которую прочитаны настройки и остатки
//
Функция ПолучитьСвободнуюМаркировку(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	
	МоментДокумента = СсылкаНаОбъект.МоментВремени();
	ДатаДокумента   = СсылкаНаОбъект.Дата;
	
	ПолеКода         = ПолеКодаШтрихкодаВЗапросе("БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки");
	ПолеТипаУпаковки = ПолеТипаУпаковкиВЗапросе("БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки");
	
	ТекстВыборки = "";
	Если Не ПустаяСтрока(ПолеКода) Тогда
		ТекстВыборки = ТекстВыборки + ",
	|	" + ПолеКода + " КАК КодШтрихкода";
	КонецЕсли;
	Если Не ПустаяСтрока(ПолеТипаУпаковки) Тогда
		ТекстВыборки = ТекстВыборки + ",
	|	" + ПолеТипаУпаковки + " КАК ТипУпаковки";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	МИНИМУМ(РеализацияТоваровУслугТовары.НомерСтроки) КАК НомерСтроки,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество,
	|	СУММА(ВЫБОР
	|			КОГДА ОписаниеНоменклатурыИС.Номенклатура ЕСТЬ NULL
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК ЭтоМаркируемая
	|ПОМЕСТИТЬ ВТ_Документ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО РеализацияТоваровУслугТовары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Номенклатура
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документ.Номенклатура КАК Номенклатура,
	|	ВТ_Документ.НомерСтроки КАК НомерСтроки,
	|	ВТ_Документ.Количество КАК Количество,
	|	ЕСТЬNULL(ОстаткиПоНоменклатуре.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТ_Документ КАК ВТ_Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	|			СУММА(БНС_ОстаткиИСМПОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|		ИЗ
	|			РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&Граница, ) КАК БНС_ОстаткиИСМПОстатки
	|		ГДЕ
	|			БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	|		СГРУППИРОВАТЬ ПО
	|			БНС_ОстаткиИСМПОстатки.Номенклатура) КАК ОстаткиПоНоменклатуре
	|		ПО ВТ_Документ.Номенклатура = ОстаткиПоНоменклатуре.Номенклатура
	|ГДЕ
	|	ВТ_Документ.ЭтоМаркируемая > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	|	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	БНС_ОстаткиИСМПОстатки.КоличествоОстаток КАК Остаток,
	|	ЕСТЬNULL(БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки.Количество, 0) КАК КоличествоВКоде" + ТекстВыборки + "
	|ИЗ
	|	РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&Граница, ) КАК БНС_ОстаткиИСМПОстатки
	|ГДЕ
	|	БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	|	И БНС_ОстаткиИСМПОстатки.Номенклатура В
	|			(ВЫБРАТЬ
	|				ВТ_Документ.Номенклатура
	|			ИЗ
	|				ВТ_Документ
	|			ГДЕ
	|				ВТ_Документ.ЭтоМаркируемая > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	БНС_ОстаткиИСМПОстатки.Номенклатура,
	|	" + ВыражениеПорядкаFIFO("БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки") + "
	|АВТОУПОРЯДОЧИВАНИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документ.Номенклатура КАК Номенклатура,
	|	ВТ_Документ.НомерСтроки КАК НомерСтроки,
	|	ВТ_Документ.Количество КАК Количество
	|ИЗ
	|	ВТ_Документ КАК ВТ_Документ
	|ГДЕ
	|	ВТ_Документ.ЭтоМаркируемая = 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	// Граница "Исключая" на момент времени документа: остатки читаются без собственного
	// расхода документа, повторное заполнение проведенной реализации не искажается
	// (ТЗ, задача 2).
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментДокумента, ВидГраницы.Исключая));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТзнОбщий       = РезультатЗапроса[1].Выгрузить();
	ТзнКоды        = РезультатЗапроса[2].Выгрузить();
	ТзнБезМарокИС  = РезультатЗапроса[3].Выгрузить();
	
	ДобавитьКолонкиКодов(ТзнКоды);
	
	КэшОСУ = Новый Соответствие;
	
	Для Каждого СтрокаКода Из ТзнКоды Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаКода.КоличествоВКоде) Тогда
			СтрокаКода.КоличествоВКоде = КоличествоКодаМаркировки(СтрокаКода.ШтрихкодУпаковки);
		КонецЕсли;
		Если СтрокаКода.КоличествоВКоде <= 0 Тогда
			СтрокаКода.КоличествоВКоде = 1;
		КонецЕсли;
		
		СтрокаКода.GTIN            = ИзвлечьGTIN(СтрокаКода.КодШтрихкода);
		СтрокаКода.ЭтоМонотоварная = ЭтоМонотоварнаяУпаковкаПредставление(СтрокаКода.ТипУпаковки);
		СтрокаКода.ЭтоОСУ          = ПризнакОСУПоКоду(СтрокаКода.Номенклатура, ДатаДокумента,
			СтрокаКода.КодШтрихкода, СтрокаКода.ЭтоМонотоварная, КэшОСУ);
		
	КонецЦикла;
	
	Результат.Вставить("ТзнОбщий", ТзнОбщий);
	Результат.Вставить("ТзнКоды", ТзнКоды);
	Результат.Вставить("ТзнНеМаркируемые", ТзнБезМарокИС);
	Результат.Вставить("ДатаДокумента", ДатаДокумента);
	
	Возврат Результат;
	
КонецФункции

// Подбирает коды маркировки под количество документа по остаткам регистра БНС_ОстаткиИСМП.
//
// Режим СтрогийПодбор = Истина (по умолчанию, ТЗ задача 4): если свободных кодов меньше,
// чем требуется по строке товара, коды по этой строке НЕ подбираются вовсе - частичный
// подбор запрещен (нельзя подобрать 54 из 1000). Коды по остальным строкам подбираются.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - документ отгрузки;
//  СтрогийПодбор  - Булево - Истина: запрет частичного подбора по строке.
//
// Возвращаемое значение:
//  Структура:
//   * Успех     - Булево - Истина, если коды подобраны по всем маркируемым строкам;
//   * Коды      - ТаблицаЗначений - подобранные коды:
//      ** Номенклатура     - СправочникСсылка.Номенклатура
//      ** ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//      ** Количество       - Число - списываемый объем по коду
//      ** КоличествоВКоде  - Число - объем кода целиком
//      ** ЭтоОСУ           - Булево
//   * Контроль  - ТаблицаЗначений - сверка сумм количеств по подобранным строкам:
//      ** Номенклатура       - СправочникСсылка.Номенклатура
//      ** КоличествоДокумент - Число
//      ** КоличествоКоды     - Число
//      ** Совпадает          - Булево
//   * Сообщения           - Массив - тексты информационных сообщений;
//   * СообщенияПоСтрокам  - ТаблицаЗначений - сообщения с привязкой к строке табличной
//      части "Товары" (стандарт 1С:ИТС, ТЗ задача 5):
//      ** НомерСтроки  - Число
//      ** Номенклатура - СправочникСсылка.Номенклатура
//      ** Требуется    - Число
//      ** Доступно     - Число
//      ** Текст        - Строка
//   * НомераСтрокБезКодов  - Массив - номера строк товаров, коды по которым очищены;
//   * НеМаркируемыеПозиции - Число - количество строк вне регистра "Описание номенклатуры ИС";
//   * СтрогийПодбор        - Булево.
//
Функция ПодобратьКодыМаркировки(СсылкаНаОбъект, СтрогийПодбор = Истина) Экспорт
	
	СтруктураРезультатов = ПолучитьСвободнуюМаркировку(СсылкаНаОбъект);
	
	ТзнОбщий = СтруктураРезультатов.ТзнОбщий;
	ТзнКоды  = СтруктураРезультатов.ТзнКоды;
	
	Коды = Новый ТаблицаЗначений;
	Коды.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Коды.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	Коды.Колонки.Добавить("Количество",       Новый ОписаниеТипов("Число"));
	Коды.Колонки.Добавить("КоличествоВКоде",  Новый ОписаниеТипов("Число"));
	Коды.Колонки.Добавить("ЭтоОСУ",           Новый ОписаниеТипов("Булево"));
	
	Контроль = Новый ТаблицаЗначений;
	Контроль.Колонки.Добавить("Номенклатура",       Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Контроль.Колонки.Добавить("КоличествоДокумент", Новый ОписаниеТипов("Число"));
	Контроль.Колонки.Добавить("КоличествоКоды",     Новый ОписаниеТипов("Число"));
	Контроль.Колонки.Добавить("Совпадает",          Новый ОписаниеТипов("Булево"));
	
	Сообщения = Новый Массив;
	
	СообщенияПоСтрокам = Новый ТаблицаЗначений;
	СообщенияПоСтрокам.Колонки.Добавить("НомерСтроки",  Новый ОписаниеТипов("Число"));
	СообщенияПоСтрокам.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СообщенияПоСтрокам.Колонки.Добавить("Требуется",    Новый ОписаниеТипов("Число"));
	СообщенияПоСтрокам.Колонки.Добавить("Доступно",     Новый ОписаниеТипов("Число"));
	СообщенияПоСтрокам.Колонки.Добавить("Текст",        Новый ОписаниеТипов("Строка"));
	
	НомераСтрокБезКодов = Новый Массив;
	
	Успех = Истина;
	
	Для Каждого СтрокаПотребности Из ТзнОбщий Цикл
		
		Потребность = СтрокаПотребности.Количество;
		Доступно    = СтрокаПотребности.Остаток;
		
		Если Потребность <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// ТЗ, задача 4: частичный подбор запрещен. Если свободных кодов меньше, чем
		// требуется по строке, коды по строке не подбираются вовсе, а ранее
		// подобранные (частичные) коды удаляются.
		Если СтрогийПодбор И Доступно < Потребность Тогда
			
			Успех = Ложь;
			НомераСтрокБезКодов.Добавить(СтрокаПотребности.НомерСтроки);
			
			ТекстСообщения = СтрШаблон(
				"По товару ""%1"" недостаточно кодов маркировки (требуется %2 шт., доступно %3 шт.). "
				+ "Коды маркировки для строки очищены. Документ может быть проведен без указания марок.",
				СтрокаПотребности.Номенклатура, Потребность, Доступно);
			
			ДобавитьСообщениеПоСтроке(СообщенияПоСтрокам, Сообщения, СтрокаПотребности, ТекстСообщения);
			
			Продолжить;
			
		КонецЕсли;
		
		СколькоПодобрано = 0;
		
		МассивКодов = ТзнКоды.НайтиСтроки(Новый Структура("Номенклатура", СтрокаПотребности.Номенклатура));
		
		Для Каждого СтрокаКода Из МассивКодов Цикл
			
			Если Потребность <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			// Списываем объем кода (остаток единиц по коду из регистра): для группового
			// кода с количеством допускается частичное списание (10 из 27), для единичного
			// кода объем равен единице.
			КоличествоКСписанию = Мин(Потребность, СтрокаКода.Остаток);
			
			Если КоличествоКСписанию <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Коды.Добавить();
			НоваяСтрока.Номенклатура     = СтрокаКода.Номенклатура;
			НоваяСтрока.ШтрихкодУпаковки = СтрокаКода.ШтрихкодУпаковки;
			НоваяСтрока.Количество       = КоличествоКСписанию;
			НоваяСтрока.КоличествоВКоде  = СтрокаКода.КоличествоВКоде;
			НоваяСтрока.ЭтоОСУ           = СтрокаКода.ЭтоОСУ;
			
			Потребность      = Потребность - КоличествоКСписанию;
			СколькоПодобрано = СколькоПодобрано + КоличествоКСписанию;
			
		КонецЦикла;
		
		Если Потребность > 0 Тогда
			// Возможно только в нестрогом режиме (СтрогийПодбор = Ложь).
			Успех = Ложь;
			ТекстСообщения = СтрШаблон(
				"По товару ""%1"" подобрано %2 из %3: свободные коды исчерпаны.",
				СтрокаПотребности.Номенклатура, СколькоПодобрано, СтрокаПотребности.Количество);
			ДобавитьСообщениеПоСтроке(СообщенияПоСтрокам, Сообщения, СтрокаПотребности, ТекстСообщения);
		КонецЕсли;
		
		СтрокаКонтроля = Контроль.Добавить();
		СтрокаКонтроля.Номенклатура       = СтрокаПотребности.Номенклатура;
		СтрокаКонтроля.КоличествоДокумент = СтрокаПотребности.Количество;
		СтрокаКонтроля.КоличествоКоды     = СколькоПодобрано;
		СтрокаКонтроля.Совпадает          = (СколькоПодобрано = СтрокаПотребности.Количество);
		
		Если Не СтрокаКонтроля.Совпадает Тогда
			Успех = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	// Номенклатура, не значащаяся в регистре сведений "Описание номенклатуры ИС",
	// не является маркируемой для подбора - обязательно сообщаем об этом,
	// чтобы маркируемый товар не пропускался молча.
	ТзнНеМаркируемые = СтруктураРезультатов.ТзнНеМаркируемые;
	Если ТзнНеМаркируемые.Количество() > 0 Тогда
		
		ИменаНоменклатуры = Новый Массив;
		Для Каждого СтрокаНе Из ТзнНеМаркируемые Цикл
			ИменаНоменклатуры.Добавить(Строка(СтрокаНе.Номенклатура));
		КонецЦикла;
		
		Сообщения.Добавить(СтрШаблон(
			"Коды маркировки не подобраны (номенклатура не значится в регистре сведений ""Описание номенклатуры ИС""): %1. "
			+ "Если номенклатура маркируется - обновите описание номенклатуры ИС (БИП) и проверьте коды в справочнике ""Штрихкоды упаковок и товаров"".",
			СтрСоединить(ИменаНоменклатуры, ", ")));
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Успех",      Успех);
	Результат.Вставить("Коды",       Коды);
	Результат.Вставить("Контроль",   Контроль);
	Результат.Вставить("Сообщения",  Сообщения);
	Результат.Вставить("СообщенияПоСтрокам", СообщенияПоСтрокам);
	Результат.Вставить("НомераСтрокБезКодов", НомераСтрокБезКодов);
	Результат.Вставить("НеМаркируемыеПозиции", ТзнНеМаркируемые.Количество());
	Результат.Вставить("СтрогийПодбор", СтрогийПодбор);
	
	Возврат Результат;
	
КонецФункции

// Переводит индикатор маркировки указанных строк табличной части "Товары" в нейтральное
// состояние: сбрасывает служебные реквизиты-индикаторы, если они есть в конфигурации
// (ТЗ, задача 4 - "индикатор статуса маркировки перевести в нейтральный статус").
//
// Параметры:
//  Объект      - ДокументОбъект - документ с табличной частью "Товары";
//  НомераСтрок  - Массив - номера строк табличной части, по которым коды очищены.
//
Процедура СброситьСтатусыМаркировкиСтрокТаблицыТоваров(Объект, НомераСтрок) Экспорт
	
	Если НомераСтрок = Неопределено Или НомераСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеТоваров = Объект.Метаданные().ТабличныеЧасти.Найти("Товары");
	Если МетаданныеТоваров = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = СтрРазделить(
		"СтатусМаркировки,СостояниеМаркировки,МаркировкаПроверена,КодыМаркировкиЗаполнены,КодыМаркировкиПроверены",
		",", Ложь);
	
	Для Каждого СтрокаТовар Из Объект.Товары Цикл
		
		Если НомераСтрок.Найти(СтрокаТовар.НомерСтроки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
			
			Реквизит = МетаданныеТоваров.Реквизиты.Найти(ИмяРеквизита);
			Если Реквизит = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				// Нейтральное (пустое) значение реквизита-индикатора маркировки.
				СтрокаТовар[ИмяРеквизита] = Реквизит.Тип.ПривестиЗначение(Неопределено);
			Исключение
				// Реквизит недоступен для изменения - не мешаем выполнению команды.
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПризнакиИКоличестваКодов

// Определяет, применяется ли по номенклатуре объемно-сортовой учет (ОСУ).
//
// Признак определяется по настройкам товарной категории номенклатуры (вида продукции
// ГИСМТ) через штатный интерфейс подсистемы "Интеграция с ИС МП": если для категории
// действует оптовый учет по ОСУ и не действует поэкземплярный учет, возвращается Истина.
//
// Параметры:
//  Номенклатура  - СправочникСсылка.Номенклатура;
//  ДатаДокумента - Дата, Неопределено - дата документа, на которую должны действовать
//                  настройки. Параметр зарезервирован для периодических настроек
//                  товарных категорий: применяется в ПризнакОСУДляДвижения().
//
// Возвращаемое значение:
//  Булево - Истина, если по товарной категории применяется объемно-сортовой учет.
//
Функция ЭтоОСУ(Номенклатура, ДатаДокумента = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		
		ДанныеНоменклатуры   = ОбщегоНазначенияИС.ОписаниеНоменклатуры(Номенклатура);
		ОписаниеНоменклатуры = ДанныеНоменклатуры[Номенклатура];
		
		Если ОписаниеНоменклатуры <> Неопределено И ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
			
			ВидПродукцииГИСМТ = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(
				ОписаниеНоменклатуры.КлючВидовПродукции, "ГИСМТ");
			
			Если ЗначениеЗаполнено(ВидПродукцииГИСМТ) Тогда
				Возврат КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетОбъемноСортовойУчет(ВидПродукцииГИСМТ);
			КонецЕсли;
			
		КонецЕсли;
		
	Исключение
		// Настройки товарной категории недоступны (иная версия библиотеки ИС).
		// Признак в этом случае определяется по типу упаковки в ПризнакОСУДляДвижения().
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает значение реквизита движения "ОбъемноСортовойУчет" (ТЗ, задача 3):
//  - поштучный код DataMatrix (01)GTIN(21)серийный номер - Ложь;
//  - групповой код ОСУ (02)GTIN(37)Количество или упаковка с типом
//    "Монотоварная упаковка" - Истина;
//  - в остальных случаях - по настройкам товарной категории на дату документа.
//
// Параметры:
//  Номенклатура       - СправочникСсылка.Номенклатура;
//  ДатаДокумента      - Дата, Неопределено - дата документа;
//  ШтрихкодУпаковки   - СправочникСсылка.ШтрихкодыУпаковокТоваров, Неопределено - код упаковки.
//
// Возвращаемое значение:
//  Булево
//
Функция ПризнакОСУДляДвижения(Номенклатура, ДатаДокумента = Неопределено, ШтрихкодУпаковки = Неопределено) Экспорт
	
	КодШтрихкода   = "";
	ЭтоМонотоварная = Ложь;
	
	Если ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
		КодШтрихкода    = КодШтрихкодаУпаковки(ШтрихкодУпаковки);
		ЭтоМонотоварная = ЭтоМонотоварнаяУпаковка(ШтрихкодУпаковки);
	КонецЕсли;
	
	Возврат ПризнакОСУПоКоду(Номенклатура, ДатаДокумента, КодШтрихкода, ЭтоМонотоварная);
	
КонецФункции

// Возвращает Истина, если код штрихкода упаковки является групповым кодом ОСУ
// (02)GTIN(37)Количество.
//
// Параметры:
//  КодШтрихкода - Строка - значение штрихкода упаковки.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоГрупповойКодОСУ(КодШтрихкода) Экспорт
	
	Код = СокрЛП(Строка(КодШтрихкода));
	Если ПустаяСтрока(Код) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрНайти(Код, "(02)") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Код без скобок: 02 + GTIN-14 + 37 + количество.
	Если Лев(Код, 2) = "02" И СтрДлина(Код) > 16 И Сред(Код, 17, 2) = "37" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает Истина, если код штрихкода упаковки является поштучным кодом маркировки
// DataMatrix (01)GTIN(21)серийный номер.
//
// Параметры:
//  КодШтрихкода - Строка - значение штрихкода упаковки.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоПоштучныйКодМаркировки(КодШтрихкода) Экспорт
	
	Код = СокрЛП(Строка(КодШтрихкода));
	Если ПустаяСтрока(Код) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// ИИ 21 - серийный номер, ИИ 01 - GTIN экземпляра.
	Если СтрНайти(Код, "(21)") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(Код, "(01)") > 0 Тогда
		Возврат СтрНайти(Код, "(02)") = 0;
	КонецЕсли;
	
	// Код без скобок: 01 + GTIN-14 + 21 + серийный номер.
	Если СтрДлина(Код) > 16 И Лев(Код, 2) = "01" И Сред(Код, 17, 2) = "21" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Извлекает GTIN-14 из кода штрихкода упаковки: из идентификаторов применения
// (01) или (02), из кода без скобок (01.../02...) либо из обычного штрихкода
// EAN-8/EAN-13/GTIN-14 (ТЗ, задача 1 - списание в разрезе "Номенклатура + GTIN").
//
// Параметры:
//  КодШтрихкода - Строка - значение штрихкода упаковки.
//
// Возвращаемое значение:
//  Строка - GTIN-14 (14 цифр) или пустая строка, если GTIN не распознан.
//
Функция ИзвлечьGTIN(КодШтрихкода) Экспорт
	
	Код = СокрЛП(Строка(КодШтрихкода));
	Если ПустаяСтрока(Код) Тогда
		Возврат "";
	КонецЕсли;
	
	// (01)GTIN(21)... или (02)GTIN(37)...
	Для Каждого ИдентификаторПрименения Из СтрРазделить("01,02", ",", Ложь) Цикл
		
		Позиция = СтрНайти(Код, "(" + ИдентификаторПрименения + ")");
		Если Позиция > 0 Тогда
			Возврат НормализоватьGTIN(Сред(Код, Позиция + 4, 14));
		КонецЕсли;
		
	КонецЦикла;
	
	// 01GTIN21... или 02GTIN37... без скобок
	Если Лев(Код, 2) = "01" Или Лев(Код, 2) = "02" Тогда
		Если СтрДлина(Код) >= 16 Тогда
			Возврат НормализоватьGTIN(Сред(Код, 3, 14));
		КонецЕсли;
	КонецЕсли;
	
	// Обычный штрихкод EAN-8/EAN-13/GTIN-14 (без идентификаторов применения)
	Если СтрокаСодержитТолькоЦифры(Код) Тогда
		Возврат НормализоватьGTIN(Код);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает значение штрихкода (кода маркировки) элемента справочника
// "Штрихкоды упаковок и товаров".
//
// Параметры:
//  ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров, Неопределено
//
// Возвращаемое значение:
//  Строка
//
Функция КодШтрихкодаУпаковки(ШтрихкодУпаковки) Экспорт
	
	Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяРеквизита = ИмяРеквизитаКодаШтрихкода();
	Если Не ПустаяСтрока(ИмяРеквизита) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШтрихкодУпаковки, ИмяРеквизита);
		Если ЗначениеЗаполнено(ЗначенияРеквизитов[ИмяРеквизита]) Тогда
			Возврат СокрЛП(Строка(ЗначенияРеквизитов[ИмяРеквизита]));
		КонецЕсли;
	КонецЕсли;
	
	// Запасной вариант - представление элемента справочника.
	Возврат СокрЛП(Строка(ШтрихкодУпаковки));
	
КонецФункции

// Возвращает количество единиц продукции, закрепленное за кодом маркировки.
//
// Параметры:
//  ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//
// Возвращаемое значение:
//  Число - объем кода; для поштучного кода - 1.
//
Функция КоличествоКодаМаркировки(ШтрихкодУпаковки) Экспорт
	
	Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Метаданные.Справочники.ШтрихкодыУпаковокТоваров.Реквизиты.Найти("Количество") <> Неопределено Тогда
		
		РеквизитыШтрихкода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШтрихкодУпаковки, "Количество");
		КоличествоВКоде = РеквизитыШтрихкода.Количество;
		Если ЗначениеЗаполнено(КоличествоВКоде) И КоличествоВКоде > 0 Тогда
			Возврат КоличествоВКоде;
		КонецЕсли;
		
	КонецЕсли;
	
	// Количество может быть закодировано в самом коде маркировки.
	КоличествоВКоде = РаспарситьКоличествоИзКода(КодШтрихкодаУпаковки(ШтрихкодУпаковки));
	Если КоличествоВКоде > 0 Тогда
		Возврат КоличествоВКоде;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

// Извлекает количество единиц продукции из кода маркировки.
// Старый формат: 31 символ - один код = одна единица.
// Новый формат: в конец кода добавлено количество
// (010460000000001221ABC1234567890100 - 100 единиц в коде).
//
// Параметры:
//  КодМаркировки - Строка
//
// Возвращаемое значение:
//  Число - количество единиц в коде; если количество не закодировано - 1.
//
Функция РаспарситьКоличествоИзКода(КодМаркировки) Экспорт
	
	КодМаркировки = СокрЛП(Строка(КодМаркировки));
	ДлинаКода     = СтрДлина(КодМаркировки);
	
	Если ДлинаКода = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	// 1. Групповой код GS1-128 с идентификатором применения 37 (количество):
	//    (02)09000100980739(37)30 - 30 единиц, (02)09000100980739(37)64 - 64 единицы.
	ПозицияИИ37 = СтрНайти(КодМаркировки, "(37)");
	Если ПозицияИИ37 > 0 Тогда
		
		СтрокаКоличества = "";
		Для Индекс = ПозицияИИ37 + 3 По ДлинаКода Цикл
			Символ = Сред(КодМаркировки, Индекс, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				СтрокаКоличества = СтрокаКоличества + Символ;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Количество = ЧислоИзСтрокиБезопасно(СтрокаКоличества);
		Если Количество > 0 Тогда
			Возврат Количество;
		КонецЕсли;
		
	КонецЕсли;
	
	// 2. Формат кода с количеством в конце: стандартный код - 31 символ,
	//    все, что длиннее, содержит количество (010460000000001221ABC1234567890100 - 100 единиц).
	Если ДлинаКода > 31 Тогда
		
		СтрокаКоличества = Сред(КодМаркировки, 32);
		Если СтрокаСодержитТолькоЦифры(СтрокаКоличества) Тогда
			Количество = ЧислоИзСтрокиБезопасно(СтрокаКоличества);
			Если Количество > 0 Тогда
				Возврат Количество;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// 3. Поштучный код маркировки (01)GTIN(21)серийный или стандартный DataMatrix - 1 единица.
	Возврат 1;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает таблицу потребности документа реализации по табличной части "Товары":
// Номенклатура, НомерСтроки, Количество, ЭтоМаркируемая.
//
// Параметры:
//  Ссылка - ДокументСсылка.РеализацияТоваровУслуг
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаПотребностиРеализации(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.НомерСтроки КАК НомерСтроки,
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	ВЫБОР
	|		КОГДА ОписаниеНоменклатурыИС.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоМаркируемая
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК Товары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС
	|		ПО Товары.Номенклатура = ОписаниеНоменклатурыИС.Номенклатура
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает таблицу кодов маркировки, указанных в табличной части "ШтрихкодыУпаковок"
// документа реализации: Номенклатура, ШтрихкодУпаковки, Количество, КодШтрихкода, GTIN,
// ЭтоМонотоварная, Использовано.
//
// Параметры:
//  Ссылка - ДокументСсылка.РеализацияТоваровУслуг
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаКодовРеализации(Ссылка)
	
	ПолеКода         = ПолеКодаШтрихкодаВЗапросе("ШтрихкодыУпаковок.ШтрихкодУпаковки");
	ПолеТипаУпаковки = ПолеТипаУпаковкиВЗапросе("ШтрихкодыУпаковок.ШтрихкодУпаковки");
	
	ТекстВыборки = "";
	Если Не ПустаяСтрока(ПолеКода) Тогда
		ТекстВыборки = ТекстВыборки + ",
	|	" + ПолеКода + " КАК КодШтрихкода";
	КонецЕсли;
	Если Не ПустаяСтрока(ПолеТипаУпаковки) Тогда
		ТекстВыборки = ТекстВыборки + ",
	|	" + ПолеТипаУпаковки + " КАК ТипУпаковки";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыУпаковок.НомерСтроки КАК НомерСтроки,
	|	ШтрихкодыУпаковок.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	ШтрихкодыУпаковок.Количество КАК Количество,
	|	ШтрихкодыУпаковок.ШтрихкодУпаковки.Номенклатура КАК Номенклатура" + ТекстВыборки + "
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.ШтрихкодыУпаковок КАК ШтрихкодыУпаковок
	|ГДЕ
	|	ШтрихкодыУпаковок.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДобавитьКолонкиКодов(Результат);
	Результат.Колонки.Добавить("Использовано", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаКода Из Результат Цикл
		СтрокаКода.GTIN            = ИзвлечьGTIN(СтрокаКода.КодШтрихкода);
		СтрокаКода.ЭтоМонотоварная = ЭтоМонотоварнаяУпаковкаПредставление(СтрокаКода.ТипУпаковки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает остатки кодов маркировки в порядке FIFO (по дате упаковки штрихкода):
// Номенклатура, ШтрихкодУпаковки, Остаток, КодШтрихкода, GTIN, ЭтоМонотоварная.
//
// Параметры:
//  МоментВремени      - МоментВремени - момент времени документа;
//  МассивНоменклатуры - Массив - номенклатура, по которой читаются остатки.
//
// Возвращаемое значение:
//  ТаблицаЗначений
//
Функция ТаблицаОстатковКодов(МоментВремени, МассивНоменклатуры)
	
	ПолеКода         = ПолеКодаШтрихкодаВЗапросе("БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки");
	ПолеТипаУпаковки = ПолеТипаУпаковкиВЗапросе("БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки");
	
	ТекстВыборки = "";
	Если Не ПустаяСтрока(ПолеКода) Тогда
		ТекстВыборки = ТекстВыборки + ",
	|	" + ПолеКода + " КАК КодШтрихкода";
	КонецЕсли;
	Если Не ПустаяСтрока(ПолеТипаУпаковки) Тогда
		ТекстВыборки = ТекстВыборки + ",
	|	" + ПолеТипаУпаковки + " КАК ТипУпаковки";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	|	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	БНС_ОстаткиИСМПОстатки.КоличествоОстаток КАК Остаток" + ТекстВыборки + "
	|ИЗ
	|	РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&Граница, ) КАК БНС_ОстаткиИСМПОстатки
	|ГДЕ
	|	БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	|	И БНС_ОстаткиИСМПОстатки.Номенклатура В (&Номенклатура)
	|
	|УПОРЯДОЧИТЬ ПО
	|	" + ВыражениеПорядкаFIFO("БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки");
	
	// Граница "Исключая" на момент времени документа: собственные движения документа,
	// записанные на его момент времени, в расчет остатков не попадают (ТЗ, задача 2).
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ДобавитьКолонкиКодов(Результат);
	
	Для Каждого СтрокаОстатка Из Результат Цикл
		СтрокаОстатка.GTIN            = ИзвлечьGTIN(СтрокаОстатка.КодШтрихкода);
		СтрокаОстатка.ЭтоМонотоварная = ЭтоМонотоварнаяУпаковкаПредставление(СтрокаОстатка.ТипУпаковки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Устанавливает управляемую блокировку данных регистра БНС_ОстаткиИСМП
// в разрезе номенклатуры документа (ТЗ, задача 2).
//
// Параметры:
//  МассивНоменклатуры - Массив - номенклатура, по которой блокируются данные.
//
Процедура ЗаблокироватьОстаткиИСМП(МассивНоменклатуры)
	
	Если МассивНоменклатуры = Неопределено Или МассивНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	Для Каждого НоменклатураБлокировки Из МассивНоменклатуры Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.БНС_ОстаткиИСМП");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Номенклатура", НоменклатураБлокировки);
	КонецЦикла;
	
	Блокировка.Заблокировать();
	
КонецПроцедуры

// Списание строки товаров с объемно-сортовым учетом: FIFO по остаткам
// в разрезе "Номенклатура + GTIN" (ТЗ, задача 1).
//
// Параметры:
//  Движения           - набор записей регистра БНС_ОстаткиИСМП;
//  Источник           - ДокументОбъект.РеализацияТоваровУслуг;
//  СтрокаПотребности  - СтрокаТаблицыЗначений - строка потребности документа;
//  КодыСтроки         - Массив - коды маркировки, указанные по строке;
//  Остатки            - ТаблицаЗначений - остатки кодов (порядок FIFO);
//  КэшОСУ             - Соответствие - кэш признака ОСУ по номенклатуре.
//
Процедура СписатьСтрокуОСУ(Движения, Источник, СтрокаПотребности, КодыСтроки, Остатки, КэшОСУ)
	
	// Количество к списанию - количество товара по строке документа. Количество,
	// указанное в кодах, может быть устаревшим (например, после изменения количества
	// товара в проведенном документе), поэтому берется количество строки.
	ОсталосьСписать = СтрокаПотребности.Количество;
	
	Если ОсталосьСписать <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	// GTIN, по которым списываются остатки, - из (01)/(02) кодов, указанных в документе.
	НаборГТИН = Новый Массив;
	Для Каждого СтрокаКода Из КодыСтроки Цикл
		GTINКода = СтрокаКода.GTIN;
		Если ЗначениеЗаполнено(GTINКода) И НаборГТИН.Найти(GTINКода) = Неопределено Тогда
			НаборГТИН.Добавить(GTINКода);
		КонецЕсли;
	КонецЦикла;
	
	ОстаткиСтроки = Остатки.НайтиСтроки(Новый Структура("Номенклатура", СтрокаПотребности.Номенклатура));
	
	// Остатки упорядочены по дате упаковки штрихкода (FIFO), см. ТаблицаОстатковКодов().
	Для Каждого СтрокаОстатка Из ОстаткиСтроки Цикл
		
		Если ОсталосьСписать <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если НаборГТИН.Количество() > 0 Тогда
			GTINОстатка = СтрокаОстатка.GTIN;
			Если ПустаяСтрока(GTINОстатка) Или НаборГТИН.Найти(GTINОстатка) = Неопределено Тогда
				// Остаток другого GTIN: в этой реализации он не списывается.
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		КоличествоПоОстатку = Мин(ОсталосьСписать, СтрокаОстатка.Остаток);
		Если КоличествоПоОстатку <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписатьДвижениеРасхода(Движения, Источник, СтрокаОстатка, КоличествоПоОстатку, КэшОСУ);
		
		// Уменьшаем остаток в таблице, чтобы один и тот же остаток не был списан дважды
		// (например, по двум строкам документа с этой же номенклатурой).
		СтрокаОстатка.Остаток = СтрокаОстатка.Остаток - КоличествоПоОстатку;
		ОсталосьСписать       = ОсталосьСписать - КоличествоПоОстатку;
		
	КонецЦикла;
	
	Если ОсталосьСписать > 0 Тогда
		// Сообщение информационное: проведение документа не блокируется (ТЗ, задача 4).
		СообщитьПоСтрокеТоваров(СтрокаПотребности.НомерСтроки, СтрШаблон(
			"По товару ""%1"" недостаточно остатков кодов маркировки для списания "
			+ "(требуется %2, списано %3 шт.). Движения по регистру (БНС) остатки ИС МП сформированы "
			+ "в пределах остатка, документ проводится.",
			СтрокаПотребности.Номенклатура, СтрокаПотребности.Количество,
			СтрокаПотребности.Количество - ОсталосьСписать));
	КонецЕсли;
	
КонецПроцедуры

// Списание строки товаров с поштучным (поэкземплярным) учетом: расход формируется
// по указанным в документе кодам маркировки в пределах фактического остатка по коду.
//
// Параметры:
//  Движения           - набор записей регистра БНС_ОстаткиИСМП;
//  Источник           - ДокументОбъект.РеализацияТоваровУслуг;
//  СтрокаПотребности  - СтрокаТаблицыЗначений - строка потребности документа;
//  КодыСтроки         - Массив - коды маркировки, указанные по строке;
//  Остатки            - ТаблицаЗначений - остатки кодов;
//  КэшОСУ             - Соответствие - кэш признака ОСУ по номенклатуре.
//
Процедура СписатьСтрокуПоэкземплярно(Движения, Источник, СтрокаПотребности, КодыСтроки, Остатки, КэшОСУ)
	
	ОсталосьСписать = СтрокаПотребности.Количество;
	Если ОсталосьСписать <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОстаткиСтроки = Остатки.НайтиСтроки(Новый Структура("Номенклатура", СтрокаПотребности.Номенклатура));
	
	Для Каждого СтрокаКода Из КодыСтроки Цикл
		
		Если ОсталосьСписать <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если СтрокаКода.Использовано = Истина Тогда
			Продолжить;
		КонецЕсли;
		СтрокаКода.Использовано = Истина;
		
		// Количество по коду: из табличной части документа; для поштучного кода
		// маркировки по умолчанию - одна единица продукции.
		КоличествоКода = СтрокаКода.Количество;
		Если КоличествоКода <= 0 Тогда
			КоличествоКода = 1;
		КонецЕсли;
		
		СтрокаОстатка = НайтиОстатокПоКоду(ОстаткиСтроки, СтрокаКода);
		
		Если СтрокаОстатка = Неопределено Или СтрокаОстатка.Остаток <= 0 Тогда
			// Движение не формируется, чтобы не создавать "виртуальный" расход
			// и отрицательный остаток. Сообщение не блокирует проведение.
			СообщитьПоСтрокеТоваров(СтрокаПотребности.НомерСтроки, СтрШаблон(
				"По товару ""%1"" не найден остаток кода маркировки ""%2"" в регистре (БНС) остатки ИС МП. "
				+ "Движение расхода по коду не сформировано - проверьте поступление кода.",
				СтрокаПотребности.Номенклатура, СтрокаКода.КодШтрихкода));
			Продолжить;
		КонецЕсли;
		
		КоличествоПоОстатку = Мин(ОсталосьСписать, КоличествоКода, СтрокаОстатка.Остаток);
		Если КоличествоПоОстатку <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписатьДвижениеРасхода(Движения, Источник, СтрокаОстатка, КоличествоПоОстатку, КэшОСУ);
		
		СтрокаОстатка.Остаток = СтрокаОстатка.Остаток - КоличествоПоОстатку;
		ОсталосьСписать       = ОсталосьСписать - КоличествоПоОстатку;
		
	КонецЦикла;
	
КонецПроцедуры

// Создает движение расхода по регистру БНС_ОстаткиИСМП по фактической записи остатка
// (штрихкод упаковки берется из остатка - "схлопывание" расхода по существующим кодам).
//
// Параметры:
//  Движения      - набор записей регистра БНС_ОстаткиИСМП;
//  Источник      - ДокументОбъект - документ реализации;
//  СтрокаОстатка - СтрокаТаблицыЗначений - запись остатка кода;
//  Количество    - Число - списываемое количество;
//  КэшОСУ        - Соответствие - кэш признака ОСУ по номенклатуре.
//
Процедура ЗаписатьДвижениеРасхода(Движения, Источник, СтрокаОстатка, Количество, КэшОСУ)
	
	Движение = Движения.БНС_ОстаткиИСМП.Добавить();
	Движение.ВидДвижения         = ВидДвиженияНакопления.Расход;
	Движение.Период              = Источник.Дата;
	Движение.Регистратор         = Источник.Ссылка;
	Движение.ШтрихкодУпаковки    = СтрокаОстатка.ШтрихкодУпаковки;
	Движение.Номенклатура        = СтрокаОстатка.Номенклатура;
	Движение.Количество          = Количество;
	Движение.ОбъемноСортовойУчет = ПризнакОСУПоКоду(СтрокаОстатка.Номенклатура, Источник.Дата,
		СтрокаОстатка.КодШтрихкода, СтрокаОстатка.ЭтоМонотоварная, КэшОСУ);
	
КонецПроцедуры

// Возвращает строку остатка по указанному в документе коду маркировки:
// сначала по тому же элементу справочника штрихкодов, затем по тому же GTIN.
//
// Параметры:
//  ОстаткиСтроки - Массив - строки остатков по номенклатуре;
//  СтрокаКода    - СтрокаТаблицыЗначений - код маркировки из документа.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено
//
Функция НайтиОстатокПоКоду(ОстаткиСтроки, СтрокаКода)
	
	Для Каждого СтрокаОстатка Из ОстаткиСтроки Цикл
		Если СтрокаОстатка.Остаток > 0 И СтрокаОстатка.ШтрихкодУпаковки = СтрокаКода.ШтрихкодУпаковки Тогда
			Возврат СтрокаОстатка;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(СтрокаКода.GTIN) Тогда
		Для Каждого СтрокаОстатка Из ОстаткиСтроки Цикл
			Если СтрокаОстатка.Остаток > 0 И СтрокаОстатка.GTIN = СтрокаКода.GTIN Тогда
				Возврат СтрокаОстатка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает коды маркировки документа, относящиеся к строке товаров
// (сопоставление по номенклатуре штрихкода упаковки).
//
// Параметры:
//  Коды              - ТаблицаЗначений - коды документа (ТаблицаКодовРеализации);
//  СтрокаПотребности - СтрокаТаблицыЗначений - строка потребности документа.
//
// Возвращаемое значение:
//  Массив - строки таблицы кодов.
//
Функция КодыСтрокиДокумента(Коды, СтрокаПотребности)
	
	Результат = Новый Массив;
	
	МассивКодов = Коды.НайтиСтроки(Новый Структура("Номенклатура", СтрокаПотребности.Номенклатура));
	
	Для Каждого СтрокаКода Из МассивКодов Цикл
		Если СтрокаКода.Использовано = Истина Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(СтрокаКода);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает признак применения алгоритма ОСУ к строке товаров: Истина, если по
// товарной категории на дату документа действует объемно-сортовой учет либо если
// в документе указан групповой код ОСУ (02)GTIN(37)Количество.
//
// Параметры:
//  Номенклатура  - СправочникСсылка.Номенклатура;
//  ДатаДокумента - Дата - дата документа;
//  КодыСтроки    - Массив - коды маркировки строки;
//  КэшОСУ        - Соответствие - кэш признака ОСУ по номенклатуре.
//
// Возвращаемое значение:
//  Булево
//
Функция ПризнакОСУАлгоритма(Номенклатура, ДатаДокумента, КодыСтроки, КэшОСУ)
	
	Для Каждого СтрокаКода Из КодыСтроки Цикл
		Если ЭтоГрупповойКодОСУ(СтрокаКода.КодШтрихкода) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЭтоОСУСКэшем(Номенклатура, ДатаДокумента, КэшОСУ);
	
КонецФункции

// Возвращает значение реквизита движения "ОбъемноСортовойУчет" по уже прочитанным
// значениям кода штрихкода и типа упаковки (ТЗ, задача 3).
//
// Параметры:
//  Номенклатура      - СправочникСсылка.Номенклатура;
//  ДатаДокумента     - Дата, Неопределено - дата документа;
//  КодШтрихкода      - Строка - значение штрихкода упаковки;
//  ЭтоМонотоварная   - Булево - тип упаковки "Монотоварная упаковка";
//  КэшОСУ            - Соответствие, Неопределено - кэш признака ОСУ.
//
// Возвращаемое значение:
//  Булево
//
Функция ПризнакОСУПоКоду(Номенклатура, ДатаДокумента, КодШтрихкода, ЭтоМонотоварная, КэшОСУ = Неопределено)
	
	Код = СокрЛП(Строка(КодШтрихкода));
	
	// 1. Поштучный код DataMatrix (01)GTIN(21)серийный номер - объемно-сортовой
	//    учет не применяется (ТЗ, задача 3).
	Если ЭтоПоштучныйКодМаркировки(Код) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// 2. Групповой код ОСУ (02)GTIN(37)Количество или упаковка с типом
	//    "Монотоварная упаковка" - объемно-сортовой учет применяется (ТЗ, задача 3).
	Если ЭтоГрупповойКодОСУ(Код) Или ЭтоМонотоварная Тогда
		Возврат Истина;
	КонецЕсли;
	
	// 3. Остальные случаи - по настройкам товарной категории на дату документа.
	Возврат ЭтоОСУСКэшем(Номенклатура, ДатаДокумента, КэшОСУ);
	
КонецФункции

// Возвращает признак ОСУ по номенклатуре с использованием кэша
// (в пределах одного проведения документа).
//
// Параметры:
//  Номенклатура  - СправочникСсылка.Номенклатура;
//  ДатаДокумента - Дата, Неопределено - дата документа;
//  КэшОСУ        - Соответствие, Неопределено - кэш признака ОСУ.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоОСУСКэшем(Номенклатура, ДатаДокумента, КэшОСУ = Неопределено)
	
	Если КэшОСУ = Неопределено Тогда
		Возврат ЭтоОСУ(Номенклатура, ДатаДокумента);
	КонецЕсли;
	
	КлючКэша = Строка(Номенклатура);
	Признак   = КэшОСУ.Получить(КлючКэша);
	Если Признак = Неопределено Тогда
		Признак = ЭтоОСУ(Номенклатура, ДатаДокумента);
		КэшОСУ.Вставить(КлючКэша, Признак);
	КонецЕсли;
	
	Возврат Признак;
	
КонецФункции

// Возвращает номенклатуру маркируемых строк таблицы потребности (без повторов).
//
// Параметры:
//  Потребности - ТаблицаЗначений - таблица потребности документа
//                (Номенклатура, НомерСтроки, Количество, ЭтоМаркируемая).
//
// Возвращаемое значение:
//  Массив
//
Функция НоменклатураМаркируемыхСтрок(Потребности)
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаПотребности Из Потребности Цикл
		
		Если Не СтрокаПотребности.ЭтоМаркируемая Тогда
			Продолжить;
		КонецЕсли;
		
		Номенклатура = СтрокаПотребности.Номенклатура;
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.Найти(Номенклатура) = Неопределено Тогда
			Результат.Добавить(Номенклатура);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Добавляет в результат подбора сообщение по строке табличной части "Товары"
// (стандарт 1С:ИТС, ТЗ задача 5): одно сообщение на строку с нехваткой.
//
// Параметры:
//  СообщенияПоСтрокам - ТаблицаЗначений - сообщения с привязкой к строкам;
//  Сообщения          - Массив - тексты сообщений;
//  СтрокаПотребности  - СтрокаТаблицыЗначений - строка потребности документа;
//  ТекстСообщения     - Строка - текст сообщения.
//
Процедура ДобавитьСообщениеПоСтроке(СообщенияПоСтрокам, Сообщения, СтрокаПотребности, ТекстСообщения)
	
	СтрокаСообщения = СообщенияПоСтрокам.Добавить();
	СтрокаСообщения.НомерСтроки  = СтрокаПотребности.НомерСтроки;
	СтрокаСообщения.Номенклатура = СтрокаПотребности.Номенклатура;
	СтрокаСообщения.Требуется    = СтрокаПотребности.Количество;
	СтрокаСообщения.Доступно     = СтрокаПотребности.Остаток;
	СтрокаСообщения.Текст        = ТекстСообщения;
	
	Сообщения.Добавить(ТекстСообщения);
	
КонецПроцедуры

// Выводит пользователю сообщение с привязкой к ячейке табличной части "Товары"
// (стандарт 1С:ИТС, ТЗ задача 5). Сообщение информационное: параметр "Отказ"
// не заполняется, проведение документа не блокируется.
//
// Параметры:
//  НомерСтроки     - Число - номер строки табличной части "Товары";
//  ТекстСообщения  - Строка - текст сообщения.
//
Процедура СообщитьПоСтрокеТоваров(НомерСтроки, ТекстСообщения) Экспорт
	
	// Полный путь к данным указывается в параметре "Поле" (пример использования
	// ОбщегоНазначенияКлиентСервер.СообщитьПользователю для формы объекта).
	ПолеОшибки = СтрШаблон("Объект.Товары[%1].Количество", НомерСтроки);
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		ТекстСообщения,
		,
		ПолеОшибки,
		,
		Ложь);
	
КонецПроцедуры

// Выводит пользователю сообщения по результату подбора кодов маркировки
// (возвращаемое значение ПодобратьКодыМаркировки).
//
// Сообщения по строкам табличной части "Товары" выводятся с привязкой к ячейке
// "Объект.Товары[%1].Количество" - по одному сообщению на строку с нехваткой
// (ТЗ, задача 5; стандарт 1С:ИТС). Прочие сообщения (без привязки к строке)
// выводятся по одному разу. Отказ = Ложь: сообщения информационные и не блокируют
// ни заполнение, ни проведение документа (ТЗ, задача 4).
//
// Параметры:
//  РезультатПодбора - Структура - результат ПодобратьКодыМаркировки();
//  ПрефиксСообщения - Строка - необязательный префикс сообщения (например,
//                     представление документа при пакетной обработке).
//
Процедура ВывестиСообщенияПодбора(РезультатПодбора, ПрефиксСообщения = "") Экспорт
	
	Если РезультатПодбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыведенныеТексты = Новый Соответствие;
	
	Если РезультатПодбора.Свойство("СообщенияПоСтрокам") Тогда
		Для Каждого СтрокаСообщения Из РезультатПодбора.СообщенияПоСтрокам Цикл
			СообщитьПоСтрокеТоваров(СтрокаСообщения.НомерСтроки, ПрефиксСообщения + СтрокаСообщения.Текст);
			ВыведенныеТексты.Вставить(СтрокаСообщения.Текст, Истина);
		КонецЦикла;
	КонецЕсли;
	
	Если РезультатПодбора.Свойство("Сообщения") Тогда
		Для Каждого ТекстСообщения Из РезультатПодбора.Сообщения Цикл
			Если ВыведенныеТексты.Получить(Строка(ТекстСообщения)) <> Неопределено Тогда
				// Текст уже выведен с привязкой к строке - повторно не показываем.
				Продолжить;
			КонецЕсли;
			ОбщегоНазначения.СообщитьПользователю(ПрефиксСообщения + ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает номенклатуру элемента справочника "Штрихкоды упаковок и товаров".
//
// Параметры:
//  ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//
// Возвращаемое значение:
//  СправочникСсылка.Номенклатура, Неопределено
//
Функция НоменклатураШтрихкодаУпаковки(ШтрихкодУпаковки)
	
	Если Метаданные.Справочники.ШтрихкодыУпаковокТоваров.Реквизиты.Найти("Номенклатура") <> Неопределено Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШтрихкодУпаковки, "Номенклатура");
		Возврат ЗначенияРеквизитов.Номенклатура;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает Истина, если тип упаковки из справочника "Штрихкоды упаковок и товаров"
// соответствует монотоварной упаковке (ТЗ, задача 3).
//
// Параметры:
//  ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоМонотоварнаяУпаковка(ШтрихкодУпаковки)
	
	Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяРеквизита = ИмяРеквизитаТипаУпаковки();
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШтрихкодУпаковки, ИмяРеквизита);
	
	Возврат ЭтоМонотоварнаяУпаковкаПредставление(ЗначенияРеквизитов[ИмяРеквизита]);
	
КонецФункции

// Возвращает Истина, если представление типа упаковки соответствует монотоварной упаковке.
//
// Параметры:
//  ТипУпаковки - Произвольный - значение (представление) типа упаковки.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоМонотоварнаяУпаковкаПредставление(ТипУпаковки)
	
	Если Не ЗначениеЗаполнено(ТипУпаковки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтрНайти(ВРег(Строка(ТипУпаковки)), "МОНОТОВАРНАЯ") > 0;
	
КонецФункции

// Добавляет в таблицу кодов (остатков) служебные колонки GTIN, ЭтоМонотоварная и ЭтоОСУ,
// а также колонки КодШтрихкода и ТипУпаковки, если их нет в конфигурации.
//
// Параметры:
//  Таблица - ТаблицаЗначений - таблица кодов (остатков).
//
Процедура ДобавитьКолонкиКодов(Таблица)
	
	Если Таблица.Колонки.Найти("КодШтрихкода") = Неопределено Тогда
		Таблица.Колонки.Добавить("КодШтрихкода", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если Таблица.Колонки.Найти("ТипУпаковки") = Неопределено Тогда
		Таблица.Колонки.Добавить("ТипУпаковки", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если Таблица.Колонки.Найти("GTIN") = Неопределено Тогда
		Таблица.Колонки.Добавить("GTIN", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Если Таблица.Колонки.Найти("ЭтоМонотоварная") = Неопределено Тогда
		Таблица.Колонки.Добавить("ЭтоМонотоварная", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если Таблица.Колонки.Найти("ЭтоОСУ") = Неопределено Тогда
		Таблица.Колонки.Добавить("ЭтоОСУ", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
КонецПроцедуры

// Возвращает имя реквизита справочника "Штрихкоды упаковок и товаров",
// в котором хранится значение штрихкода (кода маркировки).
//
// Возвращаемое значение:
//  Строка - имя реквизита или пустая строка, если реквизит не найден.
//
Функция ИмяРеквизитаКодаШтрихкода()
	
	Реквизиты = Метаданные.Справочники.ШтрихкодыУпаковокТоваров.Реквизиты;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("ЗначениеШтрихкода,Штрихкод,КодШтрихкода", ",", Ложь) Цикл
		Если Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Возвращает имя реквизита справочника "Штрихкоды упаковок и товаров",
// в котором хранится тип упаковки.
//
// Возвращаемое значение:
//  Строка - имя реквизита или пустая строка, если реквизит не найден.
//
Функция ИмяРеквизитаТипаУпаковки()
	
	Реквизиты = Метаданные.Справочники.ШтрихкодыУпаковокТоваров.Реквизиты;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("ТипУпаковки,ТипТоварнойУпаковки", ",", Ложь) Цикл
		Если Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
			Возврат ИмяРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Возвращает поле кода штрихкода для текста запроса по указанному префиксу таблицы.
//
// Параметры:
//  ПрефиксТаблицы - Строка - например, "БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки".
//
// Возвращаемое значение:
//  Строка - выражение запроса или пустая строка, если реквизит не найден.
//
Функция ПолеКодаШтрихкодаВЗапросе(ПрефиксТаблицы)
	
	ИмяРеквизита = ИмяРеквизитаКодаШтрихкода();
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПрефиксТаблицы + "." + ИмяРеквизита;
	
КонецФункции

// Возвращает поле типа упаковки для текста запроса по указанному префиксу таблицы.
//
// Параметры:
//  ПрефиксТаблицы - Строка - например, "БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки".
//
// Возвращаемое значение:
//  Строка - выражение запроса или пустая строка, если реквизит не найден.
//
Функция ПолеТипаУпаковкиВЗапросе(ПрефиксТаблицы)
	
	ИмяРеквизита = ИмяРеквизитаТипаУпаковки();
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПрефиксТаблицы + "." + ИмяРеквизита;
	
КонецФункции

// Возвращает выражение сортировки остатков по правилу FIFO (по дате упаковки штрихкода).
//
// Реквизит даты упаковки может отсутствовать в конфигурации, поэтому выражение строится
// адаптивно: при наличии реквизита - сортировка по дате упаковки и по ссылке штрихкода,
// иначе - только по ссылке штрихкода (стабильный детерминированный порядок).
//
// Параметры:
//  ПрефиксТаблицы - Строка - например, "БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки".
//
// Возвращаемое значение:
//  Строка - выражение для секции "УПОРЯДОЧИТЬ ПО" текста запроса.
//
Функция ВыражениеПорядкаFIFO(ПрефиксТаблицы)
	
	Реквизиты = Метаданные.Справочники.ШтрихкодыУпаковокТоваров.Реквизиты;
	
	Если Реквизиты.Найти("ДатаУпаковки") <> Неопределено Тогда
		Возврат ПрефиксТаблицы + ".ДатаУпаковки, " + ПрефиксТаблицы;
	КонецЕсли;
	
	Возврат ПрефиксТаблицы;
	
КонецФункции

// Приводит значение GTIN к 14 цифрам, дополняя его слева нулями.
//
// Параметры:
//  ЗначениеGTIN - Строка, Число - значение GTIN.
//
// Возвращаемое значение:
//  Строка - GTIN-14 или пустая строка, если значение не распознано.
//
Функция НормализоватьGTIN(ЗначениеGTIN)
	
	GTIN = СокрЛП(Строка(ЗначениеGTIN));
	
	Если Не СтрокаСодержитТолькоЦифры(GTIN) Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрДлина(GTIN) < 8 Или СтрДлина(GTIN) > 14 Тогда
		Возврат "";
	КонецЕсли;
	
	Пока СтрДлина(GTIN) < 14 Цикл
		GTIN = "0" + GTIN;
	КонецЦикла;
	
	Возврат GTIN;
	
КонецФункции

// Возвращает Истина, если строка состоит только из цифр.
//
// Параметры:
//  СтрокаПроверки - Строка
//
// Возвращаемое значение:
//  Булево
//
Функция СтрокаСодержитТолькоЦифры(СтрокаПроверки)
	
	Если СтрДлина(СтрокаПроверки) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		Символ = Сред(СтрокаПроверки, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Преобразует строку цифр в число.
//
// Параметры:
//  СтрокаЧисла - Строка
//
// Возвращаемое значение:
//  Число - 0, если строка не является числом.
//
Функция ЧислоИзСтрокиБезопасно(СтрокаЧисла)
	
	Если Не СтрокаСодержитТолькоЦифры(СтрокаЧисла) Тогда
		Возврат 0;
	КонецЕсли;
	
	Попытка
		Возврат Число(СтрокаЧисла);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

#КонецОбласти
