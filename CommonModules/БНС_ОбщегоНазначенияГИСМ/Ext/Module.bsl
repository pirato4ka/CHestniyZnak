#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

Процедура ДокументПриПроведении(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Не БНС_ОбщегоНазначенияГИСМПовтИсп.ВестиУчетГИСМ() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		
		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();
		
		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл
			
			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения         = ВидДвиженияНакопления.Приход;
			Движение.Период              = Источник.Дата;
			Движение.Регистратор         = Источник.Ссылка;
			
			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Движение.ШтрихкодУпаковки    = ШтрихкодУпаковки;
			Движение.Номенклатура        = ШтрихкодУпаковки.Номенклатура;
			Движение.Количество          = ШтрихкодУпаковки.Количество;
			Движение.ОбъемноСортовойУчет = ОбъемноСортовойУчет(ШтрихкодУпаковки.Номенклатура);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();
		
		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл
			
			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения         = ВидДвиженияНакопления.Расход;
			Движение.Период              = Источник.Дата;
			Движение.Регистратор         = Источник.Ссылка;
			
			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Движение.ШтрихкодУпаковки    = ШтрихкодУпаковки;
			Движение.Номенклатура        = ШтрихкодУпаковки.Номенклатура;
			Движение.Количество          = ШтрихкодУпаковки.Количество;
			Движение.ОбъемноСортовойУчет = ОбъемноСортовойУчет(ШтрихкодУпаковки.Номенклатура);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеМаркировки

// Заполняет ТЧ ШтрихкодыУпаковок документа реализации.
// ОСУ    - одна строка на номенклатуру: (02)GTIN(37)Количество, Количество = всё количество строки.
// Штучно - N свободных марок из остатков БНС_ОстаткиИСМП (по 1 шт).
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.РеализацияТоваровУслуг
//
// Возвращаемое значение:
//  Структура - Сообщения (Массив строк), НеХватает (Массив номенклатуры)
//
Функция ЗаполнитьКодыМаркировкиПоОстаткам(ДокументОбъект) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("НеХватает", Новый Массив);
	
	Если Не БНС_ОбщегоНазначенияГИСМПовтИсп.ВестиУчетГИСМ() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТоварыКМаркировке = ПолучитьТоварыКМаркировке(ДокументОбъект);
	
	// Граница "Исключая": собственные движения документа в остатки не попадают (перепроведение).
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Граница = Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая);
	Иначе
		Граница = ДокументОбъект.Дата;
	КонецЕсли;
	
	Для Каждого СтрТовара Из ТоварыКМаркировке Цикл
		
		Номенклатура = СтрТовара.Номенклатура;
		
		УдалитьСтрокиМаркировкиПоНоменклатуре(ДокументОбъект, Номенклатура);
		
		Если ОбъемноСортовойУчет(Номенклатура) Тогда
			ЗаполнитьМаркировкуОСУ(ДокументОбъект, СтрТовара, Результат);
		Иначе
			ЗаполнитьМаркировкуШтучно(ДокументОбъект, СтрТовара, Граница, Результат);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъемноСортовойУчет(НоменклатураСсылка)
	
	// 1. Получаем описание номенклатуры через кэш подсистемы ИС
	ДанныеНоменклатуры   = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НоменклатураСсылка);
	ОписаниеНоменклатуры = ДанныеНоменклатуры[НоменклатураСсылка];
	
	ВидПродукцииГИСМТ = Справочники.ВидыПродукцииИС.ПустаяСсылка();
	
	// 2. Извлекаем Вид продукции ГИСМТ из полученного ключа
	Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
		ВидПродукцииГИСМТ = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(
			ОписаниеНоменклатуры.КлючВидовПродукции,
			"ГИСМТ");
	КонецЕсли;
	
	// 3. Штатная проверка: использует ли этот вид продукции объемно-сортовой учет (ОСУ)
	ЭтоОСУ = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетОбъемноСортовойУчет(ВидПродукцииГИСМТ);
	
	Возврат ЭтоОСУ;
	
КонецФункции

Функция НЭП_ОбъемноСортовойУчет(НоменклатураСсылка)
	
	Возврат ОбъемноСортовойУчет(НоменклатураСсылка);
	
КонецФункции

Функция ПолучитьТоварыКМаркировке(ДокументОбъект)
	
	Товары = ДокументОбъект.Товары.Выгрузить(, "Номенклатура, Количество");
	Товары.Свернуть("Номенклатура", "Количество");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Количество КАК Количество
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&Товары КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.Количество КАК Количество
	|ИЗ
	|	ВТ_Товары КАК Т
	|ГДЕ
	|	Т.Номенклатура В
	|		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ОписаниеНоменклатурыИС.Номенклатура
	|		ИЗ
	|			РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС)";
	Запрос.УстановитьПараметр("Товары", Товары);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура УдалитьСтрокиМаркировкиПоНоменклатуре(ДокументОбъект, Номенклатура)
	
	Для Индекс = 1 По ДокументОбъект.ШтрихкодыУпаковок.Количество() Цикл
		ТекИндекс = ДокументОбъект.ШтрихкодыУпаковок.Количество() - Индекс;
		Если ДокументОбъект.ШтрихкодыУпаковок[ТекИндекс].ШтрихкодУпаковки.Номенклатура = Номенклатура Тогда
			ДокументОбъект.ШтрихкодыУпаковок.Удалить(ТекИндекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// ---------------------------- Ветка ОСУ ----------------------------

Процедура ЗаполнитьМаркировкуОСУ(ДокументОбъект, СтрТовара, Результат)
	
	GTIN14 = ПолучитьGTIN14(СтрТовара.Номенклатура);
	
	Если Не ЗначениеЗаполнено(GTIN14) Тогда
		Результат.НеХватает.Добавить(СтрТовара.Номенклатура);
		Результат.Сообщения.Добавить(СтрШаблон(
			НСтр("ru = 'Не найден GTIN для номенклатуры %1, код ОСУ не сформирован.'"),
			СтрТовара.Номенклатура));
		Возврат;
	КонецЕсли;
	
	КодОСУ = "(02)" + GTIN14 + "(37)" + Формат(СтрТовара.Количество, "ЧГ=0");
	
	Упаковка = НайтиИлиСоздатьУпаковкуОСУ(КодОСУ, СтрТовара.Номенклатура, СтрТовара.Количество);
	
	НоваяСтрока = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
	НоваяСтрока.ШтрихкодУпаковки = Упаковка;
	
КонецПроцедуры

Функция НайтиИлиСоздатьУпаковкуОСУ(КодОСУ, Номенклатура, Количество)
	
	// ПРОВЕРИТЬ: если в справочнике есть отдельный реквизит значения штрихкода,
	// ищите по нему, а не по наименованию.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Упаковки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ШтрихкодыУпаковокТоваров КАК Упаковки
	|ГДЕ
	|	Упаковки.Наименование = &Код
	|	И Упаковки.Номенклатура = &Номенклатура
	|	И Упаковки.Количество = &Количество
	|	И НЕ Упаковки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Код", КодОСУ);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Количество", Количество);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Элемент = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
	Элемент.Наименование = КодОСУ;
	Элемент.Номенклатура = Номенклатура;
	Элемент.Количество   = Количество;
	// ПРОВЕРИТЬ имена реквизитов и значений перечислений, затем раскомментировать:
	// Элемент.ЗначениеШтрихкода = КодОСУ;
	// Элемент.ТипУпаковки       = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка;
	// Элемент.ТипШтрихкода      = Перечисления.ТипыШтрихкодов.GS1_128;
	Элемент.Записать();
	
	Возврат Элемент.Ссылка;
	
КонецФункции

Функция ПолучитьGTIN14(Номенклатура)
	
	// ПРОВЕРИТЬ: источник GTIN. Здесь стандартный РС БП "ШтрихкодыНоменклатуры".
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ШтрихкодыНоменклатуры.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.ШтрихкодыНоменклатуры КАК ШтрихкодыНоменклатуры
	|ГДЕ
	|	ШтрихкодыНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Штрихкод = СокрЛП(Выборка.Штрихкод);
		Длина = СтрДлина(Штрихкод);
		Если Длина >= 8 И Длина <= 14 И СтрокаТолькоЦифры(Штрихкод) Тогда
			Возврат Лев("00000000000000", 14 - Длина) + Штрихкод;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция СтрокаТолькоЦифры(Строка)
	
	Для Позиция = 1 По СтрДлина(Строка) Цикл
		Если Найти("0123456789", Сред(Строка, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// ------------------------ Ветка штучного учета ------------------------

Процедура ЗаполнитьМаркировкуШтучно(ДокументОбъект, СтрТовара, Граница, Результат)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ШтрихкодУпаковки КАК ШтрихкодУпаковки
	|ИЗ
	|	РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&Граница, Номенклатура = &Номенклатура) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.ШтрихкодУпаковки.ДатаУпаковки";
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Номенклатура", СтрТовара.Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Нужно     = СтрТовара.Количество;
	Заполнено = 0;
	
	Пока Заполнено < Нужно И Выборка.Следующий() Цикл
		НоваяСтрока = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
		НоваяСтрока.ШтрихкодУпаковки = Выборка.ШтрихкодУпаковки;
		Заполнено = Заполнено + 1;
	КонецЦикла;
	
	Если Заполнено < Нужно Тогда
		Результат.НеХватает.Добавить(СтрТовара.Номенклатура);
		Результат.Сообщения.Добавить(СтрШаблон(
			НСтр("ru = 'Недостаточно марок по номенклатуре %1: нужно %2, найдено %3.'"),
			СтрТовара.Номенклатура, Нужно, Заполнено));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти