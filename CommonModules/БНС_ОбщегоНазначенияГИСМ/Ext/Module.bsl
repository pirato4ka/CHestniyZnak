#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

Процедура ДокументПриПроведении(Источник, Отказ, РежимПроведения) Экспорт

	Если Не БНС_ОбщегоНазначенияГИСМПовтИсп.ВестиУчетГИСМ() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда

		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();

		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл

			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Источник.Дата;
			Движение.Регистратор = Источник.Ссылка;

			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Движение.ШтрихкодУпаковки = ШтрихкодУпаковки;
			Движение.Номенклатура = ШтрихкодУпаковки.Номенклатура;
			Движение.Количество = ШтрихкодУпаковки.Количество;
			Движение.ОбъемноСортовойУчет = ОбъемноСортовойУчет(ШтрихкодУпаковки.Номенклатура);

		КонецЦикла;

	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда

		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();

		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл

			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
				Продолжить;
			КонецЕсли;

			ДанныеСтрокиМаркировки = Новый Структура("Номенклатура,Количество");
			ЗаполнитьЗначенияСвойств(ДанныеСтрокиМаркировки, Строка);
			НоменклатураСтроки = ДанныеСтрокиМаркировки.Номенклатура;
			Если Не ЗначениеЗаполнено(НоменклатураСтроки) Тогда
				НоменклатураСтроки = ШтрихкодУпаковки.Номенклатура;
			КонецЕсли;

			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Источник.Дата;
			Движение.Регистратор = Источник.Ссылка;
			Движение.ШтрихкодУпаковки = ШтрихкодУпаковки;
			Движение.Номенклатура = НоменклатураСтроки;
			ЭтоОСУ = ОбъемноСортовойУчет(НоменклатураСтроки);
			Движение.ОбъемноСортовойУчет = ЭтоОСУ;
			Если ЗначениеЗаполнено(ДанныеСтрокиМаркировки.Количество)
				И ДанныеСтрокиМаркировки.Количество > 0 Тогда
				Движение.Количество = ДанныеСтрокиМаркировки.Количество;
			ИначеЕсли ЭтоОСУ Тогда
				// В типовой конфигурации количество ОСУ хранится в самом групповом штрихкоде.
				Движение.Количество = ШтрихкодУпаковки.Количество;
			Иначе
				// Поэкземплярный код всегда списывается ровно в количестве одной марки.
				Движение.Количество = 1;
			КонецЕсли;
			// Для ОСУ флаг должен следовать режиму номенклатуры, а не типу упаковки.

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Функция ПолучитьСвободнуюМаркировку(СсылкаНаОбъект) Экспорт

	Результат = Новый Структура;
	ТзнОбщий = СоздатьПустуюТаблицуОбщейМаркировки();
	ТзнКоды = СоздатьПустуюТаблицуКодовМаркировки();

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Результат.Вставить("ТзнОбщий", ТзнОбщий);
		Результат.Вставить("ТзнКоды", ТзнКоды);
		Возврат Результат;
	КонецЕсли;

	МоментДокумента = СсылкаНаОбъект.МоментВремени();
	// Берем остатки до момента документа. Это также позволяет перезаполнять уже
	// проведенную реализацию, не считая ее собственный расход недоступным остатком.
	ГраницаДокумента = Новый Граница(МоментДокумента, ВидГраницы.Исключая);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	               |	И РеализацияТоваровУслугТовары.Номенклатура В
	               |		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |			ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура
	               |		ИЗ
	               |			РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровУслугТовары.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ТзнОбщий = Запрос.Выполнить().Выгрузить();
	ТзнОбщий.Колонки.Добавить("Остаток");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	               |	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	               |	БНС_ОстаткиИСМПОстатки.КоличествоОстаток КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&ДатаДокумента, ) КАК БНС_ОстаткиИСМПОстатки
	               |ГДЕ
	               |	БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	               |	И БНС_ОстаткиИСМПОстатки.Номенклатура В
	               |		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |			РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура
	               |		ИЗ
	               |			Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |		ГДЕ
	               |			РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	               |			И РеализацияТоваровУслугТовары.Номенклатура В
	               |				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура
	               |				ИЗ
	               |					РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	БНС_ОстаткиИСМПОстатки.Номенклатура,
	               |	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДатаДокумента", ГраницаДокумента);
	ТзнКоды = Запрос.Выполнить().Выгрузить();
	ТзнКоды.Колонки.Добавить("Количество");
	ТзнКоды.Колонки.Добавить("ОбъемноСортовойУчет");
	Для Каждого СтрКод Из ТзнКоды Цикл
		СтрКод.ОбъемноСортовойУчет = ОбъемноСортовойУчет(СтрКод.Номенклатура);
	КонецЦикла;

	// Сохраняем прежний контракт функции для обработчика массового заполнения.
	Для Каждого СтрОбщая Из ТзнОбщий Цикл
		СтрОбщая.Остаток = 0;
		СтрокиКодов = ТзнКоды.НайтиСтроки(Новый Структура("Номенклатура", СтрОбщая.Номенклатура));
		Для Каждого СтрКод Из СтрокиКодов Цикл
			СтрОбщая.Остаток = СтрОбщая.Остаток + СтрКод.Остаток;
			СтрКод.Количество = СтрОбщая.Количество;
		КонецЦикла;
	КонецЦикла;

	Результат.Вставить("ТзнОбщий", ТзнОбщий);
	Результат.Вставить("ТзнКоды", ТзнКоды);
	Возврат Результат;

КонецФункции

Функция ЗаполнитьМаркировкуРеализации(ДокументОбъект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Недозаполнено", Ложь);
	Результат.Вставить("КоличествоЗаписей", 0);
	Результат.Вставить("Сообщение", "");

	Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Результат.Недозаполнено = Истина;
		ДобавитьСообщениеОЗаполнении(Результат, "Сначала запишите документ, затем заполните коды маркировки.");
		Возврат Результат;
	КонецЕсли;

	СтруктураОстатков = ПолучитьСвободнуюМаркировку(ДокументОбъект.Ссылка);
	ТзнОбщий = СтруктураОстатков.ТзнОбщий;
	ТзнКоды = СтруктураОстатков.ТзнКоды;

	ДокументОбъект.ШтрихкодыУпаковок.Очистить();
	
	НомерСтрокиТовара = 0;
	КоличествоМаркируемыхСтрок = 0;
	Для Каждого СтрТовара Из ДокументОбъект.Товары Цикл
		НомерСтрокиТовара = НомерСтрокиТовара + 1;

		Если Не ЗначениеЗаполнено(СтрТовара.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		СтрокиМаркируемыхТоваров = ТзнОбщий.НайтиСтроки(Новый Структура("Номенклатура", СтрТовара.Номенклатура));
		Если СтрокиМаркируемыхТоваров.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоМаркируемыхСтрок = КоличествоМаркируемыхСтрок + 1;
		КоличествоТовара = СтрТовара.Количество;
		Если КоличествоТовара <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Окр(КоличествоТовара, 0) <> КоличествоТовара Тогда
			Результат.Недозаполнено = Истина;
			ДобавитьСообщениеОЗаполнении(Результат,
				"Строка " + Строка(НомерСтрокиТовара) + ": для маркируемого товара требуется целое количество.");
			Продолжить;
		КонецЕсли;

		Если ОбъемноСортовойУчет(СтрТовара.Номенклатура) Тогда

			GTIN14 = ПолучитьGTIN14(СтрТовара.Номенклатура);
			Если GTIN14 = "" Тогда
				Результат.Недозаполнено = Истина;
				ДобавитьСообщениеОЗаполнении(Результат,
					"Строка " + Строка(НомерСтрокиТовара) + ": не найден валидный GTIN для номенклатуры "
					+ Строка(СтрТовара.Номенклатура) + ".");
				Продолжить;
			КонецЕсли;

			СтрокаКодаОСУ = "(02)" + GTIN14 + "(37)" + Формат(КоличествоТовара, "ЧГ=0");
			ТекстОшибки = "";
			ШтрихкодОСУ = НайтиИлиСоздатьШтрихкодОСУ(
				СтрокаКодаОСУ, СтрТовара.Номенклатура, КоличествоТовара, ТекстОшибки);
			Если Не ЗначениеЗаполнено(ШтрихкодОСУ) Тогда
				Результат.Недозаполнено = Истина;
				ДобавитьСообщениеОЗаполнении(Результат, ТекстОшибки);
				Продолжить;
			КонецЕсли;

			// Ровно одна строка на исходную строку товара; количество не сводится к 1.
			НоваяСтрокаМаркировки = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
			НоваяСтрокаМаркировки.ШтрихкодУпаковки = ШтрихкодОСУ;
			УстановитьРеквизитыСтрокиМаркировки(
				НоваяСтрокаМаркировки, СтрТовара.Номенклатура, КоличествоТовара);
			Результат.КоличествоЗаписей = Результат.КоличествоЗаписей + 1;

		Иначе

			КоличествоЗаполнено = 0;
			СтрокиСвободныхМарок = ТзнКоды.НайтиСтроки(Новый Структура("Номенклатура", СтрТовара.Номенклатура));
			Для Каждого СтрКод Из СтрокиСвободныхМарок Цикл

				Если СтрКод.ОбъемноСортовойУчет Тогда
					Продолжить;
				КонецЕсли;
				Если СтрКод.Остаток < 1 Или Не ЗначениеЗаполнено(СтрКод.ШтрихкодУпаковки) Тогда
					Продолжить;
				КонецЕсли;

				// Для поэкземплярной маркировки один уникальный код используется один раз.
				НоваяСтрокаМаркировки = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
				НоваяСтрокаМаркировки.ШтрихкодУпаковки = СтрКод.ШтрихкодУпаковки;
				УстановитьРеквизитыСтрокиМаркировки(
					НоваяСтрокаМаркировки, СтрТовара.Номенклатура, 1);
				СтрКод.Остаток = 0;
				КоличествоЗаполнено = КоличествоЗаполнено + 1;
				Результат.КоличествоЗаписей = Результат.КоличествоЗаписей + 1;

				Если КоличествоЗаполнено >= КоличествоТовара Тогда
					Прервать;
				КонецЕсли;

			КонецЦикла;

			Если КоличествоЗаполнено < КоличествоТовара Тогда
				Результат.Недозаполнено = Истина;
				ДобавитьСообщениеОЗаполнении(Результат,
					"Строка " + Строка(НомерСтрокиТовара) + ": для номенклатуры "
					+ Строка(СтрТовара.Номенклатура) + " не хватает свободных марок. Требуется: "
					+ Формат(КоличествоТовара, "ЧГ=0") + ", найдено: "
					+ Формат(КоличествоЗаполнено, "ЧГ=0") + ".");
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	ПересчитатьСтатусыМаркировкиРеализации(ДокументОбъект);

	Если КоличествоМаркируемыхСтрок = 0 Тогда
		Результат.Недозаполнено = Истина;
		ДобавитьСообщениеОЗаполнении(Результат, "В документе не найдены строки маркируемой номенклатуры.");
	ИначеЕсли Не Результат.Недозаполнено Тогда
		ДобавитьСообщениеОЗаполнении(Результат,
			"Маркировка заполнена. Создано записей: " + Строка(Результат.КоличествоЗаписей) + ".");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ПересчитатьСтатусыМаркировкиРеализации(ДокументОбъект) Экспорт

	// Штатный расчет статуса по строкам товаров (1 - красный, 2 - зеленый и т. д.)
	// суммирует количество в подчиненной табличной части ШтрихкодыУпаковок.
	ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(
		ДокументОбъект, Документы.РеализацияТоваровУслуг);
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(
		ДокументОбъект, ПараметрыУказанияСерий, Неопределено, Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПустуюТаблицуОбщейМаркировки()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("Остаток");
	Возврат Таблица;

КонецФункции

Функция СоздатьПустуюТаблицуКодовМаркировки()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Номенклатура");
	Таблица.Колонки.Добавить("Количество");
	Таблица.Колонки.Добавить("ШтрихкодУпаковки");
	Таблица.Колонки.Добавить("Остаток");
	Таблица.Колонки.Добавить("ОбъемноСортовойУчет");
	Возврат Таблица;

КонецФункции

Процедура ДобавитьСообщениеОЗаполнении(Результат, ТекстСообщения)

	Если Результат.Сообщение = "" Тогда
		Результат.Сообщение = ТекстСообщения;
	Иначе
		Результат.Сообщение = Результат.Сообщение + Символы.ПС + ТекстСообщения;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьРеквизитыСтрокиМаркировки(СтрокаМаркировки, Номенклатура, Количество)

	РеквизитыТабличнойЧасти = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.ШтрихкодыУпаковок.Реквизиты;
	ЗаполняемыеРеквизиты = Новый Структура;

	Если РеквизитыТабличнойЧасти.Найти("Номенклатура") <> Неопределено Тогда
		ЗаполняемыеРеквизиты.Вставить("Номенклатура", Номенклатура);
	КонецЕсли;
	Если РеквизитыТабличнойЧасти.Найти("Количество") <> Неопределено Тогда
		ЗаполняемыеРеквизиты.Вставить("Количество", Количество);
	КонецЕсли;

	// В разных конфигурациях эти поля могут быть реквизитами строки либо
	// вычисляться по ссылке ШтрихкодУпаковки; заполняем все доступные поля.
	ЗаполнитьЗначенияСвойств(СтрокаМаркировки, ЗаполняемыеРеквизиты);

КонецПроцедуры

Функция НайтиИлиСоздатьШтрихкодОСУ(ЗначениеКода, Номенклатура, Количество, ТекстОшибки)

	ТекстОшибки = "";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ШтрихкодыУпаковокТоваров.Ссылка КАК Ссылка,
	               |	ШтрихкодыУпаковокТоваров.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |ГДЕ
	               |	НЕ ШтрихкодыУпаковокТоваров.ПометкаУдаления
	               |	И (ШтрихкодыУпаковокТоваров.Наименование = &ЗначениеКода
	               |		ИЛИ ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода = &ЗначениеКода)";
	Запрос.УстановитьПараметр("ЗначениеКода", ЗначениеКода);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Номенклатура <> Номенклатура Тогда
			ТекстОшибки = "Штрихкод ОСУ уже используется другой номенклатурой: " + ЗначениеКода + ".";
			Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		КонецЕсли;

		Попытка
			СуществующийШтрихкод = Выборка.Ссылка.ПолучитьОбъект();
			СуществующийШтрихкод.Количество = Количество;
			СуществующийШтрихкод.Записать();
		Исключение
			ТекстОшибки = "Не удалось обновить количество группового штрихкода " + ЗначениеКода + ": " + ОписаниеОшибки();
			Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
		КонецПопытки;

		Возврат Выборка.Ссылка;
	КонецЕсли;

	Попытка
		НовыйШтрихкод = Справочники.ШтрихкодыУпаковокТоваров.СоздатьЭлемент();
		НовыйШтрихкод.Наименование = ЗначениеКода;
		НовыйШтрихкод.ЗначениеШтрихкода = ЗначениеКода;
		НовыйШтрихкод.Номенклатура = Номенклатура;
		НовыйШтрихкод.Количество = Количество;
		НовыйШтрихкод.ТипУпаковки = Перечисления.ТипыУпаковок.МонотоварнаяУпаковка;
		НовыйШтрихкод.ТипШтрихкода = Перечисления.ТипыШтрихкодов.GS1_128;
		НовыйШтрихкод.Записать();
		Возврат НовыйШтрихкод.Ссылка;
	Исключение
		ТекстОшибки = "Не удалось создать штрихкод ОСУ " + ЗначениеКода + ": " + ОписаниеОшибки();
		Возврат Справочники.ШтрихкодыУпаковокТоваров.ПустаяСсылка();
	КонецПопытки;

КонецФункции

Функция ПолучитьGTIN14(Номенклатура)

	GTIN14 = ПолучитьGTINИзРегистраНоменклатуры(Номенклатура);
	Если GTIN14 <> "" Тогда
		Возврат GTIN14;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШтрихкодыУпаковокТоваров.ЗначениеШтрихкода КАК ЗначениеШтрихкода
	               |ИЗ
	               |	Справочник.ШтрихкодыУпаковокТоваров КАК ШтрихкодыУпаковокТоваров
	               |ГДЕ
	               |	ШтрихкодыУпаковокТоваров.Номенклатура = &Номенклатура
	               |	И НЕ ШтрихкодыУпаковокТоваров.ПометкаУдаления
	               |УПОРЯДОЧИТЬ ПО
	               |	ШтрихкодыУпаковокТоваров.Наименование";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		GTIN14 = НормализоватьGTIN14(Выборка.ЗначениеШтрихкода);
		Если GTIN14 <> "" Тогда
			Возврат GTIN14;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПолучитьGTINИзРегистраНоменклатуры(Номенклатура)

	МетаданныеРегистра = Метаданные.РегистрыСведений.ОписаниеGTINИС;
	Если МетаданныеРегистра.Измерения.Найти("Номенклатура") = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	ИменаПолейGTIN = Новый Массив;
	ИменаПолейGTIN.Добавить("GTIN");
	ИменаПолейGTIN.Добавить("ГТИН");
	ИменаПолейGTIN.Добавить("ЗначениеGTIN");
	ИменаПолейGTIN.Добавить("КодGTIN");
	ИменаПолейGTIN.Добавить("ЗначениеШтрихкода");
	ИменаПолейGTIN.Добавить("Штрихкод");

	Для Каждого ИмяПоля Из ИменаПолейGTIN Цикл
		ПолеНайдено = МетаданныеРегистра.Измерения.Найти(ИмяПоля) <> Неопределено
			Или МетаданныеРегистра.Ресурсы.Найти(ИмяПоля) <> Неопределено
			Или МетаданныеРегистра.Реквизиты.Найти(ИмяПоля) <> Неопределено;
		Если Не ПолеНайдено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ОписаниеGTINИС." + ИмяПоля + " КАК КодGTIN
			               |ИЗ
			               |	РегистрСведений.ОписаниеGTINИС КАК ОписаниеGTINИС
			               |ГДЕ
			               |	ОписаниеGTINИС.Номенклатура = &Номенклатура";
			Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				GTIN14 = НормализоватьGTIN14(Выборка.КодGTIN);
				Если GTIN14 <> "" Тогда
					Возврат GTIN14;
				КонецЕсли;
			КонецЦикла;
		Исключение
			// Структура регистра зависит от конфигурации-основы. При отсутствии
			// прямого соответствия используем штрихкод номенклатуры ниже.
			Продолжить;
		КонецПопытки;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НормализоватьGTIN14(ЗначениеКода)

	Если Не ЗначениеЗаполнено(ЗначениеКода) Тогда
		Возврат "";
	КонецЕсли;

	Код = СокрЛП(Строка(ЗначениеКода));
	ПозицияGTIN = СтрНайти(Код, "(01)");
	Если ПозицияGTIN > 0 Тогда
		Код = Сред(Код, ПозицияGTIN + 4, 14);
	ИначеЕсли Лев(Код, 2) = "01" И СтрДлина(Код) >= 16 Тогда
		// Вариант без скобок: AI 01 и следующие за ним 14 цифр GTIN.
		Код = Сред(Код, 3, 14);
	КонецЕсли;

	ДлинаКода = СтрДлина(Код);
	Если ДлинаКода <> 8 И ДлинаКода <> 12 И ДлинаКода <> 13 И ДлинаКода <> 14 Тогда
		Возврат "";
	КонецЕсли;

	Для Индекс = 1 По ДлинаКода Цикл
		Если СтрНайти("0123456789", Сред(Код, Индекс, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	// Проверяем контрольную цифру GTIN, чтобы не создавать групповой код
	// на основе случайного числового штрихкода.
	СуммаКонтрольнойЦифры = 0;
	Для Индекс = ДлинаКода - 1 По 1 Шаг -1 Цикл
		ВесЦифры = 1;
		Если Остаток(ДлинаКода - Индекс, 2) = 1 Тогда
			ВесЦифры = 3;
		КонецЕсли;
		СуммаКонтрольнойЦифры = СуммаКонтрольнойЦифры
			+ Число(Сред(Код, Индекс, 1)) * ВесЦифры;
	КонецЦикла;
	ОжидаемаяКонтрольнаяЦифра = Остаток(10 - Остаток(СуммаКонтрольнойЦифры, 10), 10);
	Если Число(Прав(Код, 1)) <> ОжидаемаяКонтрольнаяЦифра Тогда
		Возврат "";
	КонецЕсли;

	Возврат Прав("00000000000000" + Код, 14);

КонецФункции

Функция ОбъемноСортовойУчет(НоменклатураСсылка)

	Если Не ЗначениеЗаполнено(НоменклатураСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ДанныеНоменклатуры = ОбщегоНазначенияИС.ОписаниеНоменклатуры(НоменклатураСсылка);
		ОписаниеНоменклатуры = ДанныеНоменклатуры[НоменклатураСсылка];
		Если ОписаниеНоменклатуры = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		ВидПродукцииГИСМТ = Справочники.ВидыПродукцииИС.ПустаяСсылка();
		Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
			ВидПродукцииГИСМТ = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(
				ОписаниеНоменклатуры.КлючВидовПродукции, "ГИСМТ");
		КонецЕсли;

		Возврат КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетОбъемноСортовойУчет(
			ВидПродукцииГИСМТ);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти
