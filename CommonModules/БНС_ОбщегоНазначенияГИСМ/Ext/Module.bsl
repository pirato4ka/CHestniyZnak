#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

Процедура ДокументПриПроведении(Источник, Отказ, РежимПроведения) Экспорт

	Если Не БНС_ОбщегоНазначенияГИСМПовтИсп.ВестиУчетГИСМ() Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда

		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();

		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл

			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Источник.Дата;
			Движение.Регистратор = Источник.Ссылка;

			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Движение.ШтрихкодУпаковки = ШтрихкодУпаковки;
			Движение.Номенклатура = ШтрихкодУпаковки.Номенклатура;
			Движение.Количество = ШтрихкодУпаковки.Количество;
			Движение.ОбъемноСортовойУчет = ОбъемноСортовойУчет(ШтрихкодУпаковки.Номенклатура, Источник.Дата);

		КонецЦикла;

	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда

		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();

		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл

			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
				Продолжить;
			КонецЕсли;

			ДанныеСтрокиМаркировки = Новый Структура("Номенклатура,Количество");
			ЗаполнитьЗначенияСвойств(ДанныеСтрокиМаркировки, Строка);
			НоменклатураСтроки = ДанныеСтрокиМаркировки.Номенклатура;
			Если Не ЗначениеЗаполнено(НоменклатураСтроки) Тогда
				НоменклатураСтроки = ШтрихкодУпаковки.Номенклатура;
			КонецЕсли;

			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Источник.Дата;
			Движение.Регистратор = Источник.Ссылка;
			Движение.ШтрихкодУпаковки = ШтрихкодУпаковки;
			Движение.Номенклатура = НоменклатураСтроки;
			ЭтоОСУ = ОбъемноСортовойУчет(НоменклатураСтроки, Источник.Дата);
			Движение.ОбъемноСортовойУчет = ЭтоОСУ;
			Если ЗначениеЗаполнено(ДанныеСтрокиМаркировки.Количество)
				И ДанныеСтрокиМаркировки.Количество > 0 Тогда
				Движение.Количество = ДанныеСтрокиМаркировки.Количество;
			ИначеЕсли ЭтоОСУ Тогда
				// В типовой конфигурации количество ОСУ хранится в самом групповом штрихкоде.
				Движение.Количество = ШтрихкодУпаковки.Количество;
			Иначе
				// Поэкземплярный код всегда списывается ровно в количестве одной марки.
				Движение.Количество = 1;
			КонецЕсли;
			// Для ОСУ флаг должен следовать режиму номенклатуры, а не типу упаковки.

		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Функция ПолучитьСвободнуюМаркировку(СсылкаНаОбъект) Экспорт

	Результат = Новый Структура;
	ТзнОбщий = СоздатьПустуюТаблицуОбщейМаркировки();
	ТзнКоды = СоздатьПустуюТаблицуКодовМаркировки();

	Если Не ЗначениеЗаполнено(СсылкаНаОбъект) Тогда
		Результат.Вставить("ТзнОбщий", ТзнОбщий);
		Результат.Вставить("ТзнКоды", ТзнКоды);
		Возврат Результат;
	КонецЕсли;

	МоментДокумента = СсылкаНаОбъект.МоментВремени();
	// Берем остатки до момента документа. Это также позволяет перезаполнять уже
	// проведенную реализацию, не считая ее собственный расход недоступным остатком.
	ГраницаДокумента = Новый Граница(МоментДокумента, ВидГраницы.Исключая);

	// ДатаДокумента используется для определения режима ОСУ/Поэкземплярно по регистру сроков.
	Попытка
		ДатаДокументаДляРежима = СсылкаНаОбъект.Дата;
	Исключение
		ДатаДокументаДляРежима = ТекущаяДатаСеанса();
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	               |	И РеализацияТоваровУслугТовары.Номенклатура В
	               |		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |			ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура
	               |		ИЗ
	               |			РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровУслугТовары.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	ТзнОбщий = Запрос.Выполнить().Выгрузить();
	ТзнОбщий.Колонки.Добавить("Остаток");

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	               |	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	               |	БНС_ОстаткиИСМПОстатки.КоличествоОстаток КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&ДатаДокумента, ) КАК БНС_ОстаткиИСМПОстатки
	               |ГДЕ
	               |	БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	               |	И БНС_ОстаткиИСМПОстатки.Номенклатура В
	               |		(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |			РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура
	               |		ИЗ
	               |			Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	               |		ГДЕ
	               |			РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	               |			И РеализацияТоваровУслугТовары.Номенклатура В
	               |				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |					ОписаниеНоменклатурыИС.Номенклатура КАК Номенклатура
	               |				ИЗ
	               |					РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	БНС_ОстаткиИСМПОстатки.Номенклатура,
	               |	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Запрос.УстановитьПараметр("ДатаДокумента", ГраницаДокумента);
	ТзнКоды = Запрос.Выполнить().Выгрузить();
	ТзнКоды.Колонки.Добавить("Количество");
	ТзнКоды.Колонки.Добавить("ОбъемноСортовойУчет");
	Для Каждого СтрКод Из ТзнКоды Цикл
		СтрКод.ОбъемноСортовойУчет = ОбъемноСортовойУчет(СтрКод.Номенклатура, ДатаДокументаДляРежима);
	КонецЦикла;

	// Сохраняем прежний контракт функции для обработчика массового заполнения.
	Для Каждого СтрОбщая Из ТзнОбщий Цикл
		СтрОбщая.Остаток = 0;
		СтрокиКодов = ТзнКоды.НайтиСтроки(Новый Структура("Номенклатура", СтрОбщая.Номенклатура));
		Для Каждого СтрКод Из СтрокиКодов Цикл
			СтрОбщая.Остаток = СтрОбщая.Остаток + СтрКод.Остаток;
			СтрКод.Количество = СтрОбщая.Количество;
		КонецЦикла;
	КонецЦикла;

	Результат.Вставить("ТзнОбщий", ТзнОбщий);
	Результат.Вставить("ТзнКоды", ТзнКоды);
	Возврат Результат;

КонецФункции

Функция ЗаполнитьМаркировкуРеализации(ДокументОбъект) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Недозаполнено", Ложь);
	Результат.Вставить("КоличествоЗаписей", 0);
	Результат.Вставить("Сообщение", "");

	Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Результат.Недозаполнено = Истина;
		ДобавитьСообщениеОЗаполнении(Результат, "Сначала запишите документ, затем заполните коды маркировки.");
		Возврат Результат;
	КонецЕсли;

	// Шаг 1. Определяем ДатаДокумента для выбора режима ОСУ/Поэкземплярно по регистру сроков.
	Попытка
		ДатаДокумента = ДокументОбъект.Дата;
	Исключение
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецПопытки;
	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;

	СтруктураОстатков = ПолучитьСвободнуюМаркировку(ДокументОбъект.Ссылка);
	ТзнОбщий = СтруктураОстатков.ТзнОбщий;
	ТзнКоды = СтруктураОстатков.ТзнКоды;

	ДокументОбъект.ШтрихкодыУпаковок.Очистить();
	
	НомерСтрокиТовара = 0;
	КоличествоМаркируемыхСтрок = 0;
	// Шаг 1. Обход строк документа Товары
	Для Каждого СтрТовара Из ДокументОбъект.Товары Цикл
		НомерСтрокиТовара = НомерСтрокиТовара + 1;

		Если Не ЗначениеЗаполнено(СтрТовара.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		СтрокиМаркируемыхТоваров = ТзнОбщий.НайтиСтроки(Новый Структура("Номенклатура", СтрТовара.Номенклатура));
		Если СтрокиМаркируемыхТоваров.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоМаркируемыхСтрок = КоличествоМаркируемыхСтрок + 1;
		КоличествоТовара = СтрТовара.Количество;
		Если КоличествоТовара <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Окр(КоличествоТовара, 0) <> КоличествоТовара Тогда
			Результат.Недозаполнено = Истина;
			ДобавитьСообщениеОЗаполнении(Результат,
				"Строка " + Строка(НомерСтрокиТовара) + ": для маркируемого товара требуется целое количество.");
			Продолжить;
		КонецЕсли;

		// Определить текущий требуемый режим учета на дату документа (ДатаДокумента):
		// Обращаемся к регистру сроков ввода маркировки по категории номенклатуры.
		// Условие ОСУ (Множественный): если колонка ОптоваяТорговля.ОСУ = "действует", а ОптоваяТорговля.Поэкземплярно НЕ "действует" (или дата поэкземплярного больше даты документа).
		// Условие Поэкземплярного (Штучный): если ОптоваяТорговля.Поэкземплярно = "действует".
		РежимОСУ = ОбъемноСортовойУчет(СтрТовара.Номенклатура, ДатаДокумента);

		Если РежимОСУ Тогда

			// Шаг 2. Ветка А: Обработка ОСУ (Множественный товар)
			// Получить GTIN (14 цифр) для СтрТовара.Номенклатура из регистра сведений соответствия номенклатуры и штрихкодов/GTIN
			GTIN14 = ПолучитьGTIN14(СтрТовара.Номенклатура);
			Если GTIN14 = "" Тогда
				Результат.Недозаполнено = Истина;
				ДобавитьСообщениеОЗаполнении(Результат,
					"Строка " + Строка(НомерСтрокиТовара) + ": не найден валидный GTIN для номенклатуры "
					+ Строка(СтрТовара.Номенклатура) + ".");
				Продолжить;
			КонецЕсли;

			// Сформировать строку штрихкода GS1-128 формата (02)<GTIN>(37)<Количество>
			СтрокаКодаОСУ = "(02)" + GTIN14 + "(37)" + Формат(КоличествоТовара, "ЧГ=0");
			ТекстОшибки = "";
			ШтрихкодОСУ = НайтиИлиСоздатьШтрихкодОСУ(
				СтрокаКодаОСУ, СтрТовара.Номенклатура, КоличествоТовара, ТекстОшибки);
			Если Не ЗначениеЗаполнено(ШтрихкодОСУ) Тогда
				Результат.Недозаполнено = Истина;
				ДобавитьСообщениеОЗаполнении(Результат, ТекстОшибки);
				Продолжить;
			КонецЕсли;

			// Ровно одна запись на всю строку товара; Количество = полное количество из строки (не 1)
			// ТипУпаковки = МонотоварнаяУпаковка, ТипШтрихкода = GS1_128, статус проверки - зеленый
			НоваяСтрокаМаркировки = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
			НоваяСтрокаМаркировки.ШтрихкодУпаковки = ШтрихкодОСУ;
			УстановитьРеквизитыСтрокиМаркировки(
				НоваяСтрокаМаркировки, СтрТовара.Номенклатура, КоличествоТовара);
			Результат.КоличествоЗаписей = Результат.КоличествоЗаписей + 1;

		Иначе

			// Шаг 3. Ветка Б: Обработка штучного учета (Поэкземплярный)
			// Выполнить запрос к регистру остатков марок с лимитом ПЕРВЫЕ КоличествоТовара
			КоличествоЗаполнено = 0;
			СтрокиСвободныхМарок = ТзнКоды.НайтиСтроки(Новый Структура("Номенклатура", СтрТовара.Номенклатура));
			Для Каждого СтрКод Из СтрокиСвободныхМарок Цикл

				// Пропускаем ОСУ-коды в поштучной ветке
				Если СтрКод.ОбъемноСортовойУчет Тогда
					Продолжить;
				КонецЕсли;
				Если СтрКод.Остаток < 1 Или Не ЗначениеЗаполнено(СтрКод.ШтрихкодУпаковки) Тогда
					Продолжить;
				КонецЕсли;

				// Для поэкземплярной маркировки один уникальный код формата (01)<GTIN>(21)<Серия> используется один раз, Количество = 1
				// Тип штрихкода GS-1 Data matrix, Тип упаковки Маркированный товар (из справочника остатков)
				НоваяСтрокаМаркировки = ДокументОбъект.ШтрихкодыУпаковок.Добавить();
				НоваяСтрокаМаркировки.ШтрихкодУпаковки = СтрКод.ШтрихкодУпаковки;
				УстановитьРеквизитыСтрокиМаркировки(
					НоваяСтрокаМаркировки, СтрТовара.Номенклатура, 1);
				// Для штучного учета статус проверки также должен быть зеленый после пересчета
				СтрКод.Остаток = 0;
				КоличествоЗаполнено = КоличествоЗаполнено + 1;
				Результат.КоличествоЗаписей = Результат.КоличествоЗаписей + 1;

				Если КоличествоЗаполнено >= КоличествоТовара Тогда
					Прервать;
				КонецЕсли;

			КонецЦикла;

			Если КоличествоЗаполнено < КоличествоТовара Тогда
				Результат.Недозаполнено = Истина;
				ДобавитьСообщениеОЗаполнении(Результат,
					"Строка " + Строка(НомерСтрокиТовара) + ": для номенклатуры "
					+ Строка(СтрТовара.Номенклатура) + " не хватает свободных марок. Требуется: "
					+ Формат(КоличествоТовара, "ЧГ=0") + ", найдено: "
					+ Формат(КоличествоЗаполнено, "ЧГ=0") + ".");
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// Шаг 4. Обновление визуального статуса формы
	// Пересчитать статусы проверки маркировки документа (вызвать штатную клиент-серверную процедуру валидации дерева маркировки)
	// Убедиться, что по строкам ОСУ Итог(ТаблицаМарок.Количество) == СтрокаТовары.Количество, благодаря чему пиктограмма становится зеленой
	ПересчитатьСтатусыМаркировкиРеализации(ДокументОбъект);

	Если КоличествоМаркируемыхСтрок = 0 Тогда
		Результат.Недозаполнено = Истина;
		ДобавитьСообщениеОЗаполнении(Результат, "В документе не найдены строки маркируемой номенклатуры.");
	ИначеЕсли Не Результат.Недозаполнено Тогда
		ДобавитьСообщениеОЗаполнении(Результат,
			"Маркировка заполнена. Создано записей: " + Строка(Результат.КоличествоЗаписей) + ".");
	КонецЕсли;

	Возврат Результат;

КонецФункции

Процедура ПересчитатьСтатусыМаркировкиРеализации(ДокументОбъект) Экспорт

	// Штатный расчет статуса по строкам товаров (1 - красный, 2 - зеленый и т. д.)
	// суммирует количество в подчиненной табличной части ШтрихкодыУпаковок.
	// Для ОСУ важно Итог(ТаблицаМарок.Количество) == СтрокаТовары.Количество -> зеленый.
	Попытка
		ПараметрыУказанияСерий = НоменклатураСервер.ПараметрыУказанияСерий(
			ДокументОбъект, Документы.РеализацияТоваровУслуг);
		НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(
			ДокументОбъект, ПараметрыУказанияСерий, Неопределено, Неопределено);
	Исключение
		// Резерв: попытка установить статусы напрямую, если сервер НоменклатураСервер недоступен в тесте
		// СтатусУказанияСерий = 14 (зеленый) или Перечисления.СтатусыУказанияСерий.Проверено
		Попытка
			Для Каждого СтрТовара Из ДокументОбъект.Товары Цикл
				Если Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.Товары.Реквизиты.Найти("СтатусУказанияСерий") <> Неопределено Тогда
					// Подбираем значение статуса отвечающее за зеленый цвет (обычно 1 или 14 или Перечисления.СтатусыУказанияСерий)
					Попытка
						СтрТовара.СтатусУказанияСерий = 14;
					Исключение
						Попытка
							СтрТовара.СтатусУказанияСерий = 1;
						Исключение
						КонецПопытки;
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецПопытки;

	// Дополнительно: если в табличной части ШтрихкодыУпаковок есть реквизит СтатусУказанияСерий, устанавливаем Проверено
	Попытка
		РеквизитыМарок = Метаданные.Документы.РеализацияТоваровУслуг.ТабличныеЧасти.ШтрихкодыУпаковок.Реквизиты;
		Если РеквизитыМарок.Найти("СтатусУказанияСерий") <> Неопределено Тогда
			Для Каждого СтрМарка Из ДокументОбъект.ШтрихкодыУпаковок Цикл
				Попытка
					СтрМарка.СтатусУказанияСерий = 1;
				Исключение
					Попытка
						СтрМарка.СтатусУказанияСерий = Перечисления.СтатусыУказанияСерий.Проверено;
					Исключение
					КонецПопытки;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПустуюТаблицуОбщейМаркировки()

