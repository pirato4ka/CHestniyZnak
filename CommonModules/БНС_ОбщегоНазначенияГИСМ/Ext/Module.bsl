////////////////////////////////////////////////////////////////////////////////
//
// БНС_ОбщегоНазначенияГИСМ: серверные процедуры и функции подсистемы "ГИСМ"
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ПодпискиНаСобытия

Процедура ДокументПриПроведении(Источник, Отказ, РежимПроведения) Экспорт
	
	Если Не БНС_ОбщегоНазначенияГИСМПовтИсп.ВестиУчетГИСМ() Тогда
		Возврат
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") Тогда
		
		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();
		
		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл
			
			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения        = ВидДвиженияНакопления.Приход;
			Движение.Период             = Источник.Дата;
			Движение.Регистратор        = Источник.Ссылка;
			Движение.ШтрихкодУпаковки    = ШтрихкодУпаковки;
			Движение.Номенклатура        = ШтрихкодУпаковки.Номенклатура;
			Движение.Количество          = КоличествоКодаМаркировки(ШтрихкодУпаковки);
			Движение.ОбъемноСортовойУчет = ЭтоОСУ(ШтрихкодУпаковки.Номенклатура);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Источник) = Тип("ДокументОбъект.РеализацияТоваровУслуг") Тогда
		
		Движения = Источник.Движения;
		Движения.БНС_ОстаткиИСМП.Записывать = Истина;
		Движения.БНС_ОстаткиИСМП.Очистить();
		
		Для Каждого Строка Из Источник.ШтрихкодыУпаковок Цикл
			
			ШтрихкодУпаковки = Строка.ШтрихкодУпаковки;
			Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
				Продолжить;
			КонецЕсли;
			
			// Количество в табличной части - фактически списываемый объем
			// (для партионных кодов может быть меньше объема кода: 50 из 100).
			// Если количество не заполнено (документы, заполненные до доработки) -
			// списывается код целиком.
			КоличествоКСписанию = Строка.Количество;
			Если Не ЗначениеЗаполнено(КоличествоКСписанию) Тогда
				КоличествоКСписанию = КоличествоКодаМаркировки(ШтрихкодУпаковки);
			КонецЕсли;
			
			Движение = Движения.БНС_ОстаткиИСМП.Добавить();
			Движение.ВидДвижения        = ВидДвиженияНакопления.Расход;
			Движение.Период             = Источник.Дата;
			Движение.Регистратор        = Источник.Ссылка;
			Движение.ШтрихкодУпаковки    = ШтрихкодУпаковки;
			Движение.Номенклатура        = ШтрихкодУпаковки.Номенклатура;
			Движение.Количество          = КоличествоКСписанию;
			Движение.ОбъемноСортовойУчет = ЭтоОСУ(ШтрихкодУпаковки.Номенклатура);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеКодовМаркировки

// Возвращает данные для заполнения кодов маркировки по остаткам регистра БНС_ОстаткиИСМП.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - документ отгрузки.
//
// Возвращаемое значение:
//  Структура:
//   * ТзнОбщий - ТаблицаЗначений - потребность документа по маркируемой номенклатуре:
//      ** Номенклатура - СправочникСсылка.Номенклатура
//      ** Количество  - Число - количество по документу
//      ** Остаток     - Число - суммарный остаток единиц по кодам
//   * ТзнКоды - ТаблицаЗначений - свободные коды маркировки (ФИФО по дате упаковки):
//      ** Номенклатура     - СправочникСсылка.Номенклатура
//      ** ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//      ** Остаток          - Число - остаток единиц по коду
//      ** КоличествоВКоде  - Число - объем кода (1 код = N единиц)
//      ** ЭтоОСУ           - Булево - признак объемно-сортового учета
//
Функция ПолучитьСвободнуюМаркировку(СсылкаНаОбъект) Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТ_Документ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	|	И РеализацияТоваровУслугТовары.Номенклатура В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ОписаниеНоменклатурыИС.Номенклатура
	|			ИЗ
	|				РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Номенклатура
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Документ.Номенклатура КАК Номенклатура,
	|	ВТ_Документ.Количество КАК Количество,
	|	ЕСТЬNULL(ОстаткиПоНоменклатуре.КоличествоОстаток, 0) КАК Остаток
	|ИЗ
	|	ВТ_Документ КАК ВТ_Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	|			СУММА(БНС_ОстаткиИСМПОстатки.КоличествоОстаток) КАК КоличествоОстаток
	|		ИЗ
	|			РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&ДатаДокумента, ) КАК БНС_ОстаткиИСМПОстатки
	|		ГДЕ
	|			БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	|		СГРУППИРОВАТЬ ПО
	|			БНС_ОстаткиИСМПОстатки.Номенклатура) КАК ОстаткиПоНоменклатуре
	|		ПО ВТ_Документ.Номенклатура = ОстаткиПоНоменклатуре.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	БНС_ОстаткиИСМПОстатки.Номенклатура КАК Номенклатура,
	|	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки КАК ШтрихкодУпаковки,
	|	БНС_ОстаткиИСМПОстатки.КоличествоОстаток КАК Остаток,
	|	ЕСТЬNULL(БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки.Количество, 0) КАК КоличествоВКоде
	|ИЗ
	|	РегистрНакопления.БНС_ОстаткиИСМП.Остатки(&ДатаДокумента, ) КАК БНС_ОстаткиИСМПОстатки
	|ГДЕ
	|	БНС_ОстаткиИСМПОстатки.КоличествоОстаток > 0
	|	И БНС_ОстаткиИСМПОстатки.Номенклатура В
	|			(ВЫБРАТЬ
	|				ВТ_Документ.Номенклатура
	|			ИЗ
	|				ВТ_Документ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	БНС_ОстаткиИСМПОстатки.Номенклатура,
	|	БНС_ОстаткиИСМПОстатки.ШтрихкодУпаковки.ДатаУпаковки
	|АВТОУПОРЯДОЧИВАНИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	СУММА(РеализацияТоваровУслугТовары.Количество) КАК Количество
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	|ГДЕ
	|	РеализацияТоваровУслугТовары.Ссылка = &Ссылка
	|	И НЕ РеализацияТоваровУслугТовары.Номенклатура В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ОписаниеНоменклатурыИС.Номенклатура
	|			ИЗ
	|				РегистрСведений.ОписаниеНоменклатурыИС КАК ОписаниеНоменклатурыИС)
	|
	|СГРУППИРОВАТЬ ПО
	|	РеализацияТоваровУслугТовары.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	
	МоментДокумента = СсылкаНаОбъект.МоментВремени();
	ГраницаВключая  = Новый Граница(МоментДокумента, ВидГраницы.Включая);
	Запрос.УстановитьПараметр("ДатаДокумента", ГраницаВключая);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТзнОбщий = РезультатЗапроса[1].Выгрузить();
	ТзнКоды  = РезультатЗапроса[2].Выгрузить();
	
	// Дозаполняем объем кода (новый формат кода: количество в конце)
	// и признак ОСУ по номенклатуре.
	ТзнКоды.Колонки.Добавить("ЭтоОСУ", Новый ОписаниеТипов("Булево"));
	
	КэшОСУ = Новый Соответствие;
	
	Для Каждого СтрокаКода Из ТзнКоды Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаКода.КоличествоВКоде) Тогда
			СтрокаКода.КоличествоВКоде = КоличествоКодаМаркировки(СтрокаКода.ШтрихкодУпаковки);
		КонецЕсли;
		Если СтрокаКода.КоличествоВКоде <= 0 Тогда
			СтрокаКода.КоличествоВКоде = 1;
		КонецЕсли;
		
		ПризнакОСУ = КэшОСУ.Получить(СтрокаКода.Номенклатура);
		Если ПризнакОСУ = Неопределено Тогда
			ПризнакОСУ = ЭтоОСУ(СтрокаКода.Номенклатура);
			КэшОСУ.Вставить(СтрокаКода.Номенклатура, ПризнакОСУ);
		КонецЕсли;
		СтрокаКода.ЭтоОСУ = ПризнакОСУ;
		
	КонецЦикла;
	
	Результат.Вставить("ТзнОбщий", ТзнОбщий);
	Результат.Вставить("ТзнКоды" , ТзнКоды);
	Результат.Вставить("ТзнНеМаркируемые", РезультатЗапроса[3].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

// Подбирает коды маркировки под количество документа по остаткам регистра БНС_ОстаткиИСМП.
// Гибридный алгоритм (раздел 5 ТЗ):
//  - ОСУ: один код соответствует одной единице продукции, подбирается по одному коду на единицу;
//  - не ОСУ: коды с объемом (партионные), допускается частичное списание кода (50 из 100).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка.РеализацияТоваровУслуг - документ отгрузки.
//
// Возвращаемое значение:
//  Структура:
//   * Успех     - Булево - Истина, если по всей номенклатуре суммы сошлись;
//   * Коды      - ТаблицаЗначений - подобранные коды:
//      ** Номенклатура     - СправочникСсылка.Номенклатура
//      ** ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//      ** Количество       - Число - списываемый объем по коду
//      ** КоличествоВКоде  - Число - объем кода целиком
//      ** ЭтоОСУ           - Булево
//   * Контроль  - ТаблицаЗначений - сверка сумм количеств (критерий приемки ТЗ):
//      ** Номенклатура        - СправочникСсылка.Номенклатура
//      ** КоличествоДокумент  - Число
//      ** КоличествоКоды      - Число
//      ** Совпадает           - Булево
//   * Сообщения - Массив - тексты сообщений о недостатке кодов.
//
Функция ПодобратьКодыМаркировки(СсылкаНаОбъект) Экспорт
	
	СтруктураРезультатов = ПолучитьСвободнуюМаркировку(СсылкаНаОбъект);
	
	ТзнОбщий = СтруктураРезультатов.ТзнОбщий;
	ТзнКоды  = СтруктураРезультатов.ТзнКоды;
	
	Коды = Новый ТаблицаЗначений;
	Коды.Колонки.Добавить("Номенклатура",     Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Коды.Колонки.Добавить("ШтрихкодУпаковки", Новый ОписаниеТипов("СправочникСсылка.ШтрихкодыУпаковокТоваров"));
	Коды.Колонки.Добавить("Количество",       Новый ОписаниеТипов("Число"));
	Коды.Колонки.Добавить("КоличествоВКоде",  Новый ОписаниеТипов("Число"));
	Коды.Колонки.Добавить("ЭтоОСУ",           Новый ОписаниеТипов("Булево"));
	
	Контроль = Новый ТаблицаЗначений;
	Контроль.Колонки.Добавить("Номенклатура",       Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Контроль.Колонки.Добавить("КоличествоДокумент", Новый ОписаниеТипов("Число"));
	Контроль.Колонки.Добавить("КоличествоКоды",     Новый ОписаниеТипов("Число"));
	Контроль.Колонки.Добавить("Совпадает",          Новый ОписаниеТипов("Булево"));
	
	Сообщения = Новый Массив;
	Успех = Истина;
	
	Для Каждого СтрокаПотребность Из ТзнОбщий Цикл
		
		Потребность = СтрокаПотребность.Количество;
		
		Если СтрокаПотребность.Остаток < Потребность Тогда
			Успех = Ложь;
			Сообщения.Добавить(СтрШаблон(
				"Недостаточно кодов маркировки по товару %1: требуется %2, остаток %3.",
				СтрокаПотребность.Номенклатура, Потребность, СтрокаПотребность.Остаток));
		КонецЕсли;
		
		СколькоПодобрано = 0;
		
		МассивКодов = ТзнКоды.НайтиСтроки(Новый Структура("Номенклатура", СтрокаПотребность.Номенклатура));
		
		Для Каждого СтрокаКода Из МассивКодов Цикл
			
			Если Потребность <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			// Списываем объем кода (остаток единиц по коду из регистра):
			// одиночный код (01)GTIN(21)... - объем 1, групповой код с количеством
			// (ИИ 37 в GS1-128, количество в конце кода) - объем N, допускается
			// частичное списание кода (50 из 100). Единый алгоритм для ОСУ и не ОСУ:
			// признак ОСУ влияет только на заполнение ресурса "ОбъемноСортовойУчет".
			КоличествоКСписанию = Мин(Потребность, СтрокаКода.Остаток);
			
			Если КоличествоКСписанию <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Коды.Добавить();
			НоваяСтрока.Номенклатура     = СтрокаКода.Номенклатура;
			НоваяСтрока.ШтрихкодУпаковки = СтрокаКода.ШтрихкодУпаковки;
			НоваяСтрока.Количество       = КоличествоКСписанию;
			НоваяСтрока.КоличествоВКоде  = СтрокаКода.КоличествоВКоде;
			НоваяСтрока.ЭтоОСУ           = СтрокаКода.ЭтоОСУ;
			
			Потребность      = Потребность - КоличествоКСписанию;
			СколькоПодобрано = СколькоПодобрано + КоличествоКСписанию;
			
		КонецЦикла;
		
		Если Потребность > 0 Тогда
			Успех = Ложь;
			Сообщения.Добавить(СтрШаблон(
				"По товару %1 подобрано %2 из %3: свободные коды исчерпаны.",
				СтрокаПотребность.Номенклатура, СколькоПодобрано, СтрокаПотребность.Количество));
		КонецЕсли;
		
		СтрокаКонтроля = Контроль.Добавить();
		СтрокаКонтроля.Номенклатура       = СтрокаПотребность.Номенклатура;
		СтрокаКонтроля.КоличествоДокумент = СтрокаПотребность.Количество;
		СтрокаКонтроля.КоличествоКоды     = СколькоПодобрано;
		СтрокаКонтроля.Совпадает          = (СколькоПодобрано = СтрокаПотребность.Количество);
		
	КонецЦикла;
	
	// Номенклатура, не значащаяся в регистре сведений "Описание номенклатуры ИС",
	// не является маркируемой для подбора - обязательно сообщаем об этом,
	// чтобы маркируемый товар не пропускался молча.
	ТзнНеМаркируемые = СтруктураРезультатов.ТзнНеМаркируемые;
	Если ТзнНеМаркируемые.Количество() > 0 Тогда

		ИменаНоменклатуры = Новый Массив;
		Для Каждого СтрокаНе Из ТзнНеМаркируемые Цикл
			ИменаНоменклатуры.Добавить(Строка(СтрокаНе.Номенклатура));
		КонецЦикла;

		Сообщения.Добавить(СтрШаблон(
			"Коды маркировки не подобраны (номенклатура не значится в регистре сведений ""Описание номенклатуры ИС""): %1. Если номенклатура маркируется - обновите описание номенклатуры ИС (БИП) и проверьте коды в справочнике ""Штрихкоды упаковок и товаров"".",
			СтрСоединить(ИменаНоменклатуры, ", ")));

	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Успех",     Успех);
	Результат.Вставить("Коды",      Коды);
	Результат.Вставить("Контроль",  Контроль);
	Результат.Вставить("Сообщения", Сообщения);
	Результат.Вставить("НеМаркируемыеПозиции", ТзнНеМаркируемые.Количество());
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПризнакиИКоличестваКодов

// Определяет, ведется ли по номенклатуре объемно-сортовой учет (ОСУ).
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//  Булево - Истина, если номенклатура относится к ОСУ.
//
Функция ЭтоОСУ(Номенклатура) Экспорт
	
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// 1. Штатное определение через подсистему ИС: ОСУ определяется видом продукции ГИСМТ.
	Попытка
		
		ДанныеНоменклатуры   = ОбщегоНазначенияИС.ОписаниеНоменклатуры(Номенклатура);
		ОписаниеНоменклатуры = ДанныеНоменклатуры[Номенклатура];
		
		ВидПродукцииГИСМТ = Справочники.ВидыПродукцииИС.ПустаяСсылка();
		
		Если ЗначениеЗаполнено(ОписаниеНоменклатуры.КлючВидовПродукции) Тогда
			ВидПродукцииГИСМТ = КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииКлючаПоПодсистеме(
				ОписаниеНоменклатуры.КлючВидовПродукции,
				"ГИСМТ");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВидПродукцииГИСМТ) Тогда
			Возврат КонструкторИСОбщегоНазначенияКлиентСервер.ВидПродукцииИспользуетОбъемноСортовойУчет(ВидПродукцииГИСМТ);
		КонецЕсли;
		
	Исключение
		// Переходим к запасному варианту определения
	КонецПопытки;
	
	// 2. Запасной вариант: признак ОСУ из фактических движений регистра БНС_ОстаткиИСМП.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БНС_ОстаткиИСМП.ОбъемноСортовойУчет КАК ОбъемноСортовойУчет
	|ИЗ
	|	РегистрНакопления.БНС_ОстаткиИСМП КАК БНС_ОстаткиИСМП
	|ГДЕ
	|	БНС_ОстаткиИСМП.Номенклатура = &Номенклатура
	|	И БНС_ОстаткиИСМП.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|УПОРЯДОЧИТЬ ПО
	|	БНС_ОстаткиИСМП.Период УБЫВ";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ОбъемноСортовойУчет;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает количество единиц продукции, закрепленное за кодом маркировки.
// Новый формат кода содержит количество в конце (например, ...100 - 100 единиц в коде).
//
// Параметры:
//  ШтрихкодУпаковки - СправочникСсылка.ШтрихкодыУпаковокТоваров
//
// Возвращаемое значение:
//  Число - объем кода; для одиночного кода - 1.
//
Функция КоличествоКодаМаркировки(ШтрихкодУпаковки) Экспорт
	
	Если Не ЗначениеЗаполнено(ШтрихкодУпаковки) Тогда
		Возврат 0;
	КонецЕсли;
	
	РеквизитыШтрихкода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШтрихкодУпаковки, "Количество");
	
	КоличествоВКоде = РеквизитыШтрихкода.Количество;
	Если ЗначениеЗаполнено(КоличествоВКоде) И КоличествоВКоде > 0 Тогда
		Возврат КоличествоВКоде;
	КонецЕсли;
	
	// Количество может быть закодировано в самом коде маркировки (новый формат).
	Если Метаданные.Справочники.ШтрихкодыУпаковокТоваров.Реквизиты.Найти("ЗначениеШтрихкода") <> Неопределено Тогда
		
		РеквизитыШтрихкода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ШтрихкодУпаковки, "ЗначениеШтрихкода");
		Если ЗначениеЗаполнено(РеквизитыШтрихкода.ЗначениеШтрихкода) Тогда
			КоличествоВКоде = РаспарситьКоличествоИзКода(РеквизитыШтрихкода.ЗначениеШтрихкода);
			Если КоличествоВКоде > 0 Тогда
				Возврат КоличествоВКоде;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

// Извлекает количество единиц продукции из кода маркировки нового формата.
// Старый формат: 31 символ - один код = одна единица.
// Новый формат: в конец кода добавлено количество
// (010460000000001221ABC1234567890100 - 100 единиц в коде).
//
// Параметры:
//  КодМаркировки - Строка
//
// Возвращаемое значение:
//  Число - количество единиц в коде; если количество не закодировано - 1.
//
Функция РаспарситьКоличествоИзКода(КодМаркировки) Экспорт
	
	КодМаркировки = СокрЛП(Строка(КодМаркировки));
	ДлинаКода     = СтрДлина(КодМаркировки);
	
	Если ДлинаКода = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	// 1. Групповой код GS1-128 с идентификатором применения 37 (количество):
	//    (02)09000100980739(37)30 - 30 единиц, (02)09000100980739(37)64 - 64 единицы.
	ПозицияИИ37 = СтрНайти(КодМаркировки, "(37)");
	Если ПозицияИИ37 > 0 Тогда
		
		СтрокаКоличества = "";
		Для Индекс = ПозицияИИ37 + 3 По ДлинаКода Цикл
			Символ = Сред(КодМаркировки, Индекс, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				СтрокаКоличества = СтрокаКоличества + Символ;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Количество = ЧислоИзСтрокиБезопасно(СтрокаКоличества);
		Если Количество > 0 Тогда
			Возврат Количество;
		КонецЕсли;
		
	КонецЕсли;
	
	// 2. Формат кода с количеством в конце (ТЗ, п. 4.3): стандартный код - 31 символ,
	//    все, что длиннее, содержит количество (010460000000001221ABC1234567890100 - 100 единиц).
	Если ДлинаКода > 31 Тогда
		
		СтрокаКоличества = Сред(КодМаркировки, 32);
		Если СтрокаСодержитТолькоЦифры(СтрокаКоличества) Тогда
			Количество = ЧислоИзСтрокиБезопасно(СтрокаКоличества);
			Если Количество > 0 Тогда
				Возврат Количество;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// 3. Одиночный код маркировки (01)GTIN(21)серийный или стандартный DataMatrix - 1 единица.
	Возврат 1;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаСодержитТолькоЦифры(Знач СтрокаПроверки)
	
	Если СтрДлина(СтрокаПроверки) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		Символ = Сред(СтрокаПроверки, Индекс, 1);
		Если Символ < "0" Или Символ > "9" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЧислоИзСтрокиБезопасно(СтрокаЧисла)
	
	Если Не СтрокаСодержитТолькоЦифры(СтрокаЧисла) Тогда
		Возврат 0;
	КонецЕсли;
	
	Попытка
		Возврат Число(СтрокаЧисла);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

#КонецОбласти